# ---------- Helper Functions ----------

# Create a clickable terminal hyperlink using OSC 8 escape sequence
# Falls back to plain "label (url)" if terminal doesn't support it
# Usage: link "https://example.com" "Click here"
# Decide once, at source time, whether OSC 8 hyperlinks are safe to emit.
#
# This CANNOT be decided inside link(): every caller wraps it in $(...), where
# stdout is a pipe, so an inline [[ -t 1 ]] would always say "not a terminal".
# Capturing it here -- before any command substitution exists -- is what makes
# the check meaningful. llm-env is re-sourced per invocation, so the value is
# never stale across commands.
__llm_init_terminal() {
    if [[ -n "${LLM_ENV_TTY:-}" ]]; then
        __LLM_STDOUT_TTY="$LLM_ENV_TTY"
    elif [[ -t 1 ]]; then
        __LLM_STDOUT_TTY=1
    else
        __LLM_STDOUT_TTY=0
    fi

    case "${LLM_ENV_HYPERLINKS:-}" in
        1) __LLM_LINK_MODE="osc8";  return 0 ;;
        0) __LLM_LINK_MODE="plain"; return 0 ;;
    esac

    __LLM_LINK_MODE="plain"
    [[ "$__LLM_STDOUT_TTY" == 1 ]] || return 0
    # https://no-color.org/
    [[ -n "${NO_COLOR+x}" ]] && return 0
    case "${TERM:-}" in ''|dumb) return 0 ;; esac
    __LLM_LINK_MODE="osc8"
    return 0
}
__llm_init_terminal

# Render a hyperlink. Falls back to plain text when the terminal cannot show
# one -- which the docstring has always promised and the code never did, so
# raw OSC 8 bytes ended up in pipes, redirected files and CI logs.
link() {
    local url="$1"
    local label="${2:-$url}"
    if [[ "${__LLM_LINK_MODE:-plain}" == "osc8" ]]; then
        # The trailing \\ is part of the ST (string terminator), not an attempt
        # to escape a single quote, so disable the SC1003 false positive.
        # shellcheck disable=SC1003
        printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$url" "$label"
    elif [[ "$label" == "$url" ]]; then
        printf '%s' "$url"
    else
        printf '%s (%s)' "$label" "$url"
    fi
}

# Normalize protocol value: trim whitespace and convert to lowercase
# Returns empty string for empty/whitespace-only input
normalize_protocol() {
    local value="$1"

    # Return empty for empty string
    [[ -z "$value" && -n "${value+x}" ]] && { echo ""; return 0; }

    # Trim via the shared trim() helper.
    #
    # This used to hand-roll it as ${value##[[:space:]]*} / %%[[:space:]]*,
    # which are GLOB patterns, not character-class trims: [[:space:]] followed
    # by * matches "whitespace then anything", so a leading-space value was
    # deleted entirely ("  anthropic" -> "") and an inner space truncated it
    # ("open ai" -> "open"). Either way validate_protocol then silently fell
    # back to openai, so a provider configured for anthropic exported OPENAI_*.
    local trimmed
    trim "$value"; trimmed="$__LLM_REPLY"

    # Return empty for whitespace-only input
    [[ -z "$trimmed" ]] && { echo ""; return 0; }

    # Convert to lowercase - use tr as it's bash 3.2 compatible
    # Note: This spawns a subprocess but is unavoidable in bash 3.2
    echo "$trimmed" | tr '[:upper:]' '[:lower:]'
}

# Validate protocol value against whitelist and warn if invalid
# Returns sanitized protocol (whitelist or default)
validate_protocol() {
    local provider="$1"
    local protocol="$2"

    # Valid protocols whitelist
    local valid_openai="openai"
    local valid_anthropic="anthropic"

    # If protocol is empty after normalization, it will be defaulted later
    [[ -z "$protocol" ]] && { echo ""; return 0; }

    # Check if valid
    if [[ "$protocol" == "$valid_openai" ]] || [[ "$protocol" == "$valid_anthropic" ]]; then
        echo "$protocol"
        return 0
    fi

    # Invalid protocol - emit warning and return empty (will be defaulted to openai)
    echo "⚠️  Warning: Invalid protocol '$protocol' for provider '$provider'. Valid values: openai, anthropic. Defaulting to 'openai'." >&2
    echo ""
    return 0
}

# Normalize a max_context_tokens value to a plain decimal token count.
# Sets __LLM_REPLY: the count on success, empty on rejection so the caller
# drops the key. Usage: normalize_max_context_tokens "$prov" "$v"; n="$__LLM_REPLY"
#
# Accepts 262144, 200k, 200K, 1m, 1M. The suffixes are DECIMAL -- 200k is
# 200000, not 204800 -- matching CLAUDE_CODE_AUTO_COMPACT_WINDOW, whose
# documented maximum is exactly 1000000. Anyone wanting a power of two writes
# the integer out.
#
# One function, not the normalize_*/validate_* pair used for protocol. That
# pair is invoked as "$(normalize_protocol ...)" and "$(validate_protocol ...)",
# so every protocol= line costs two forks, and normalize_protocol spends a
# third on `tr` (recorded in docs/technical-debt.md). Nothing here forks: no
# $( ), no tr, no sed, no awk. Case folding is unnecessary because only the
# trailing unit letter has case, so the patterns simply spell both. ${var,,}
# is not an option either -- on bash 3.2 it is a parse ERROR, not merely an
# unsupported feature, and a parse error in a sourced file takes the whole
# source down with it.
#
# No [[ =~ ]]: BASH_REMATCH and zsh's $match survive this call, so load_config
# stays free to read a capture through get_match after the dispatch that calls
# us. Whether a capture happens to be live right now is not something a leaf
# validator should have to know -- see _llm_id_is_safe.
#
# Returns 0 even for garbage. A bare call that returned 1 would abort the
# caller's shell under `set -e`, and llm-env is sourced INTO that shell
# (tests/unit/test_set_u.bats pins the `set -euo pipefail` case). Rejection is
# signalled by an empty __LLM_REPLY, the contract validate_protocol also uses.
normalize_max_context_tokens() {
    local provider="${1-}" raw="${2-}" digits scale

    trim "$raw"; raw="$__LLM_REPLY"
    __LLM_REPLY=""

    # Split off an optional k/m unit. `scale` is the zeros to append, not a
    # multiplier: nothing here goes near $(( )), which would read 010 as octal
    # and silently wrap a long value into a plausible-looking lie.
    scale=""
    case "$raw" in
        *[kK]) digits="${raw%?}"; scale="000" ;;
        *[mM]) digits="${raw%?}"; scale="000000" ;;
        *)     digits="$raw" ;;
    esac

    # Digits spelled out rather than [0-9] or [[:digit:]]: a range is ordered by
    # the locale's collation table and a character class is locale-defined, and
    # this must accept ASCII 0-9 and nothing else under every LC_ALL. The same
    # test rejects an empty value, a bare "m" or "k", 1_000_000, 1.5m, -5, +7,
    # "1 m", 12k34, 1mm and 1km, because none of those leave digits behind.
    case "$digits" in
        ""|*[!0123456789]*)
            echo "⚠️  Warning: Invalid max_context_tokens '$raw' for provider '$provider'. Expected a positive integer, optionally suffixed k or m (e.g. 262144, 200k, 1m). Ignoring." >&2
            return 0
            ;;
    esac

    # Strip leading zeros rather than hand them to $(( )), where 010 is octal 8.
    # The pattern requires a second character, so a lone "0" survives to be
    # rejected below instead of becoming the empty string.
    while :; do
        case "$digits" in
            0?*) digits="${digits#0}" ;;
            *)   break ;;
        esac
    done

    # Rejects 0, 00, 0k and 000m. Checked BEFORE the unit is applied: 0k would
    # otherwise become "0000", which is digits-only and would pass every
    # remaining test.
    if [[ "$digits" == "0" ]]; then
        echo "⚠️  Warning: max_context_tokens '$raw' for provider '$provider' must be greater than zero. Ignoring." >&2
        return 0
    fi

    digits="${digits}${scale}"

    # Range by string length, not by numeric comparison: after the strip above,
    # digit count IS magnitude. Nine digits is 999,999,999 tokens -- three
    # orders of magnitude past any real context window, and small enough that a
    # consumer doing 32-bit arithmetic on it cannot overflow. On bash 3.2
    # $(( 99999999999999999999 )) yields 7766279631452241919 with exit status 0,
    # so without this an over-long value would be exported as a plausible lie.
    if [[ ${#digits} -gt 9 ]]; then
        echo "⚠️  Warning: max_context_tokens '$raw' for provider '$provider' is out of range (1-999999999). Ignoring." >&2
        return 0
    fi

    __LLM_REPLY="$digits"
    return 0
}

# Set default protocol for providers that don't have one explicitly set
# Only applies to enabled providers to avoid unnecessary work
apply_default_protocols() {
    local provider
    local existing_protocol
    local provider_enabled

    local -a base_url_keys
    get_provider_keys "PROVIDER_BASE_URLS"
    base_url_keys=(${__LLM_REPLY_KEYS[@]+"${__LLM_REPLY_KEYS[@]}"})
    for provider in ${base_url_keys[@]+"${base_url_keys[@]}"}; do
        [[ -z "$provider" ]] && continue

        # Check if provider has a protocol set
        get_provider_value "PROVIDER_PROTOCOLS" "$provider"; existing_protocol="$__LLM_REPLY"

        # Only set default if protocol is empty and provider is enabled
        # Check if provider is enabled (defaults to true if not set)
        if [[ -z "$existing_protocol" ]]; then
            # Preserve original semantics: the old `|| echo "true"` fired only on a
            # nonzero exit (which never occurred here), so an unset enabled -> empty.
            get_provider_value "PROVIDER_ENABLED" "$provider"; provider_enabled="$__LLM_REPLY"

            # Only set default for enabled providers
            if [[ "$provider_enabled" == "true" ]]; then
                set_provider_value "PROVIDER_PROTOCOLS" "$provider" "openai"
                debug "PROVIDER_PROTOCOLS[$provider] defaulted to 'openai'"
            else
                debug "PROVIDER_PROTOCOLS[$provider] not defaulted (provider disabled)"
            fi
        fi
    done
}

# Render a secret for display.
#
# Reveals at most the last 4 characters, and only when the secret is long
# enough that 4 characters are a small fraction of it. The previous version
# masked only the FIRST character of anything up to 4 long ("abcd" -> "•bcd")
# and revealed 4 of 5 for a 5-character secret -- enough to make a short token
# or a test key trivially guessable from a screenshot or a shared log.
mask() {
    local input="$1"
    local n=${#input}
    [[ -z "$input" ]] && { echo "∅"; return; }

    local reveal=0
    # Only show a tail once the secret is comfortably longer than the tail.
    if [[ $n -ge 12 ]]; then
        reveal=4
    elif [[ $n -ge 8 ]]; then
        reveal=2
    fi

    local masked="" i
    for ((i = 0; i < n - reveal; i++)); do
        masked+="•"
    done
    if [[ $reveal -gt 0 ]]; then
        masked+="${input: -$reveal}"
    fi
    echo "$masked"
}

# Extract the host from a URL. Pure parameter expansion: the previous
# `awk -F/ '{print $3}'` forked a process on every set/unset, and silently
# returned empty for a scheme-less URL.
host_from_url() {
    local url="$1"
    [[ -z "$url" ]] && { echo ""; return 0; }
    # Strip scheme:// if present; tolerate a bare host[:port]/path too.
    local rest="${url#*://}"
    # Drop everything from the first / onward, then any userinfo prefix.
    rest="${rest%%/*}"
    rest="${rest##*@}"
    echo "$rest"
}

# Validate provider name format. Allows letters, digits, underscore, hyphen,
# and dot. Dots are required to express version-bearing model ids like
# `kimi-k2.5` and `glm-5.1` introduced by quickstart schema v2.
#
# Delegates to _llm_id_is_safe so the charset rule lives in exactly one place;
# it previously existed here, in _qs_id_is_safe, and implicitly in the store.
validate_provider_name() {
    local name="$1"
    if ! _llm_id_is_safe "$name"; then
        echo "Error: Invalid provider name '$name'. Only letters, numbers, dots, underscores, and hyphens are allowed." >&2
        return 1
    fi
    return 0
}

# NOTE: sanitize_config_value was removed in 1.7.0.
#
# It stripped $ ` ; & | from values, which was both unsafe and lossy:
#
#   * it did NOT strip the apostrophe, the one character that actually broke
#     out of the accessor's eval quoting, so it never blocked the injection it
#     was named for;
#   * it silently corrupted legitimate values -- any URL with a query string
#     lost its &, including this project's own Alibaba signup URL; and
#   * it ran only on the `config add` path, not on load or quickstart.
#
# Values no longer need sanitising because they are never re-parsed: the store
# writes them with printf -v. Identifiers are validated (and rejected) by
# _llm_id_is_safe rather than silently mutated.

# Validate provider exists and is enabled
validate_provider() {
    local provider="$1"
    debug "Validating provider: $provider"
    
    # Check if provider exists
    if ! has_provider_key "PROVIDER_BASE_URLS" "$provider"; then
        debug "Provider not found: $provider"
        return 1
    fi
    
    # Check if provider is enabled
    local provider_enabled
    get_provider_value "PROVIDER_ENABLED" "$provider"; provider_enabled="$__LLM_REPLY"
    if [[ "${provider_enabled:-true}" != "true" ]]; then
        debug "Provider disabled: $provider"
        return 2
    fi
    
    debug "Provider validation successful: $provider"
    return 0
}

# ---------- Platform detection ----------
#
# Sets __LLM_PLATFORM to one of: linux macos wsl msys cygwin bsd unknown.
#
# Deliberately NOT exported. llm-env already exports CURRENT_SHELL and the
# BASH_* capability flags into every child process, which is itself a defect;
# the platform layer does not add to it.
#
# Every dependent decision has an env override so bats can force a platform
# without running on it, matching the repo's existing convention
# (LLM_ENV_QUICKSTART_DIR, LLM_ENV_DEFAULT_INSTALL_DIR).

detect_platform() {
    local osrel
    case "${LLM_ENV_PLATFORM:-}" in
        linux|macos|wsl|msys|cygwin|bsd|unknown)
            __LLM_PLATFORM="$LLM_ENV_PLATFORM"
            return 0
            ;;
    esac

    # $OSTYPE first: it is free and set by both bash and zsh.
    case "${OSTYPE:-}" in
        darwin*)      __LLM_PLATFORM="macos" ;;
        msys*|mingw*) __LLM_PLATFORM="msys" ;;   # Git Bash reports "msys"
        cygwin*)      __LLM_PLATFORM="cygwin" ;;
        freebsd*|openbsd*|netbsd*|dragonfly*) __LLM_PLATFORM="bsd" ;;
        linux*)
            # WSL2 is Linux, but its filesystem and interop behaviour differ
            # enough to be worth naming. The env vars are free but absent in
            # some contexts (systemd units, `wsl -u root`), so /proc is the
            # authority. Read with the builtin -- no grep fork.
            if [[ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" ]]; then
                __LLM_PLATFORM="wsl"
            elif [[ -r /proc/sys/kernel/osrelease ]] \
                 && read -r osrel < /proc/sys/kernel/osrelease 2>/dev/null; then
                case "$osrel" in
                    *icrosoft*|*WSL*) __LLM_PLATFORM="wsl" ;;
                    *)                __LLM_PLATFORM="linux" ;;
                esac
            else
                __LLM_PLATFORM="linux"
            fi
            ;;
        *)
            # Only fork uname when $OSTYPE was absent or unrecognised.
            case "$(uname -s 2>/dev/null)" in
                Darwin)       __LLM_PLATFORM="macos" ;;
                MINGW*|MSYS*) __LLM_PLATFORM="msys" ;;
                CYGWIN*)      __LLM_PLATFORM="cygwin" ;;
                Linux)        __LLM_PLATFORM="linux" ;;
                *BSD)         __LLM_PLATFORM="bsd" ;;
                *)            __LLM_PLATFORM="unknown" ;;
            esac
            ;;
    esac
}
detect_platform

# Normalise a possibly Windows-style path to forward slashes.
# `dirname 'C:\repo\llm-env'` finds no '/' and returns '.', which silently
# resolved the builtin config tier relative to $PWD.
__llm_normalize_path() {
    local p="$1"
    printf '%s' "${p//\\//}"
}

# Echo the rc file that exports should be appended to (empty = unsupported).
#
# Two fixes over the previous copy-pasted logic:
#   * it branches on the RUNNING shell, not $SHELL. $SHELL is the LOGIN shell,
#     so a user running bash inside a zsh login shell had their key written to
#     ~/.zshrc and was then told to source it from bash.
#   * on msys/cygwin it targets a LOGIN file. Git Bash's mintty starts
#     `bash --login -i`, which reads ~/.bash_profile, ~/.bash_login or
#     ~/.profile and never ~/.bashrc on its own -- so appending to ~/.bashrc
#     reported success and did nothing.
detect_shell_rc() {
    __LLM_RC_NEEDS_CHAIN=0
    if [[ -n "${LLM_ENV_RC_FILE:-}" ]]; then
        printf '%s' "$LLM_ENV_RC_FILE"
        return 0
    fi

    local sh="${CURRENT_SHELL:-}"
    if [[ -z "$sh" || "$sh" == "unknown" ]]; then
        case "${SHELL:-}" in
            */zsh)  sh=zsh ;;
            */bash) sh=bash ;;
            *)      sh=other ;;
        esac
    fi

    case "$sh" in
        zsh) printf '%s' "$HOME/.zshrc" ;;
        bash)
            case "${__LLM_PLATFORM:-}" in
                msys|cygwin)
                    if   [[ -f "$HOME/.bash_profile" ]]; then printf '%s' "$HOME/.bash_profile"
                    elif [[ -f "$HOME/.bash_login"   ]]; then printf '%s' "$HOME/.bash_login"
                    elif [[ -f "$HOME/.profile"      ]]; then printf '%s' "$HOME/.profile"
                    else
                        # Nothing exists yet: create the login file, and note
                        # that it may need to chain-load ~/.bashrc.
                        __LLM_RC_NEEDS_CHAIN=1
                        printf '%s' "$HOME/.bash_profile"
                    fi
                    ;;
                *)
                    if [[ ! -f "$HOME/.bashrc" && -f "$HOME/.bash_profile" ]]; then
                        printf '%s' "$HOME/.bash_profile"
                    else
                        printf '%s' "$HOME/.bashrc"
                    fi
                    ;;
            esac
            ;;
        *) printf '' ;;
    esac
}

# ---------- Portable timing ----------
#
# `date +%s.%N` is a GNU extension: BSD date (stock macOS) emits a literal "N",
# and the result was piped to bc, which Git Bash does not ship at all. Both
# failure modes were swallowed by `|| echo "N/A"`, so response time rendered as
# "N/As" on two of the three supported platforms.
#
# Prefer bash 5's EPOCHREALTIME, then zsh's datetime module, then a verified
# `date +%s%N`, then whole seconds. All arithmetic is integer.

__llm_now_ms() {
    local t frac
    if [[ -n "${EPOCHREALTIME:-}" ]]; then
        # EPOCHREALTIME uses the locale's decimal separator, hence [.,].
        t="${EPOCHREALTIME%%[.,]*}"
        frac="${EPOCHREALTIME#*[.,]}000"
        printf '%s%s' "$t" "${frac:0:3}"
        return 0
    fi
    t="$(date +%s%N 2>/dev/null)"
    if [[ "$t" =~ ^[0-9]+$ ]] && [[ ${#t} -gt 10 ]]; then
        # ns -> ms by string truncation, so there is no 64-bit overflow
        # question on any bash.
        printf '%s' "${t%??????}"
        return 0
    fi
    t="$(date +%s 2>/dev/null)"
    [[ "$t" =~ ^[0-9]+$ ]] || t=0
    printf '%s000' "$t"
}

# $1 = start ms, $2 = end ms -> "S.mmm"
__llm_fmt_duration() {
    local a="${1:-0}" b="${2:-0}" d
    [[ "$a" =~ ^[0-9]+$ ]] || a=0
    [[ "$b" =~ ^[0-9]+$ ]] || b=0
    d=$((b - a))
    [[ $d -lt 0 ]] && d=0
    printf '%d.%03d' "$((d / 1000))" "$((d % 1000))"
}

# zsh needs its datetime module loaded before EPOCHREALTIME exists.
if [[ "${CURRENT_SHELL}" == "zsh" ]] && [[ -z "${EPOCHREALTIME:-}" ]]; then
    zmodload zsh/datetime 2>/dev/null || true
fi

# ---------- Safe config rewriting ----------
#
# Every command that edits the config went through
#     transform ... "$config.backup" > "$config"
# or
#     transform ... "$config" > "$config.tmp" && mv "$config.tmp" "$config"
#
# The first form is unrecoverable: the shell truncates "$config" when it opens
# the redirect, before the transform writes a byte, so any failure leaves an
# empty config. The second never checked the transform's exit status, and mv
# from a fresh umask-created temp silently dropped the original's permissions
# (a chmod 600 config became 644).

# Directory holding timestamped backups. Honours XDG_CONFIG_HOME, which
# get_user_config_path already does -- the previous hardcoded $HOME/.config
# orphaned backups from the config they belonged to.
_config_backup_dir() {
    printf '%s' "$(dirname "$(get_user_config_path)")/backups"
}

# Copy the config to a timestamped backup; echoes the path.
# Includes $$ so two operations in the same second cannot collide.
_config_backup_file() {
    local src="$1" dir stamp out
    dir="$(_config_backup_dir)"
    mkdir -p "$dir" 2>/dev/null || return 1
    stamp="$(date +%Y%m%d_%H%M%S)"
    out="$dir/config-${stamp}-$$.conf"
    cp "$src" "$out" 2>/dev/null || return 1
    printf '%s' "$out"
}

# Rewrite $1 by piping it through the command in "$@" (from $2 on).
# The transform reads the ORIGINAL on stdin and writes the new content on
# stdout. The target is replaced only if the transform succeeds and produced
# output; permissions and ownership of the original are preserved because we
# write through the existing inode rather than mv-ing a new file over it.
_config_atomic_write() {
    local target="$1"; shift
    local tmp rc

    [[ -f "$target" ]] || return 1
    tmp="$(mktemp "${target}.XXXXXX")" || return 1

    if ! "$@" < "$target" > "$tmp"; then
        rc=$?
        rm -f "$tmp"
        debug "config rewrite failed (rc=$rc); '$target' left untouched"
        return 1
    fi

    # A transform that produced nothing is treated as a failure: no config
    # command has a legitimate reason to empty the file.
    if [[ ! -s "$tmp" ]]; then
        rm -f "$tmp"
        debug "config rewrite produced empty output; '$target' left untouched"
        return 1
    fi

    # Overwrite in place so mode, owner and any ACL survive.
    if ! cat "$tmp" > "$target"; then
        rm -f "$tmp"
        return 1
    fi
    rm -f "$tmp"
    return 0
}

# ---------- Managed environment ----------
#
# Single source of truth for the variables llm-env owns, per protocol. Both
# set_single_provider and cmd_unset consume these lists, so the two can no
# longer disagree about what "clearing" means -- which is how switching
# protocols used to leave the previous provider's host and credentials
# exported.
#
# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is deliberately NOT listed. It is a
# user preference that set_single_provider only defaults (via :-false) rather
# than owns, so unsetting it would destroy a value from the user's own profile.
LLM_MANAGED_VARS_OPENAI="OPENAI_API_KEY OPENAI_BASE_URL OPENAI_MODEL"
#
# CLAUDE_CODE_MAX_CONTEXT_TOKENS *is* listed, unlike the traffic flag above:
# llm-env derives it from the provider's own max_context_tokens, so it is owned
# outright. Leaving a previous provider's window exported is worse than never
# setting one -- Claude Code would size auto-compact to a window the new model
# does not have.
LLM_MANAGED_VARS_ANTHROPIC="ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL ANTHROPIC_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL ANTHROPIC_DEFAULT_SONNET_MODEL ANTHROPIC_DEFAULT_HAIKU_MODEL CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_MAX_CONTEXT_TOKENS"
# Protocol-agnostic variables llm-env owns outright.
LLM_MANAGED_VARS_COMMON="LLM_PROVIDER LLM_PROTOCOL OPENAI_MODEL_OVERRIDE"

# Unset every variable belonging to a protocol. $1 = openai | anthropic
_clear_protocol_env() {
    local __proto="$1" __vars __v
    case "$__proto" in
        openai)    __vars="$LLM_MANAGED_VARS_OPENAI" ;;
        anthropic) __vars="$LLM_MANAGED_VARS_ANTHROPIC" ;;
        *)         return 1 ;;
    esac
    __llm_split "$__vars"
    for __v in ${__LLM_WORDS[@]+"${__LLM_WORDS[@]}"}; do
        unset "$__v"
    done
}

# ---------- Commands ----------

# Set a single provider's environment variables
# Returns 0 on success, 1 on failure
set_single_provider() {
    local provider="$1"

    # Validate provider name format
    if ! validate_provider_name "$provider"; then
        return 1
    fi

    # Validate provider.
    # Capture the status explicitly: inside `if ! cmd`, $? is the status of the
    # negated pipeline (always 0), so the case below never matched and neither
    # message could ever print.
    local validate_rc=0
    validate_provider "$provider" || validate_rc=$?
    if [[ $validate_rc -ne 0 ]]; then
        case $validate_rc in
            1) echo "❌ Unknown provider: $provider" ;;
            2) echo "❌ Provider disabled: $provider" ;;
        esac
        echo "Available providers: ${AVAILABLE_PROVIDERS[*]-}"
        echo
        return 1
    fi

    # Get protocol for this provider (defaults to "openai")
    local protocol
    get_provider_value "PROVIDER_PROTOCOLS" "$provider"; protocol="${__LLM_REPLY:-openai}"

    local key_var model base key auth_token_var auth_token
    get_provider_value "PROVIDER_API_KEY_VARS" "$provider"; key_var="$__LLM_REPLY"
    get_provider_value "PROVIDER_BASE_URLS" "$provider"; base="$__LLM_REPLY"
    get_provider_value "PROVIDER_DEFAULT_MODELS" "$provider"; model="${OPENAI_MODEL_OVERRIDE:-$__LLM_REPLY}"
    if [[ -n "$key_var" ]]; then
        get_var_value "$key_var"; key="$__LLM_REPLY"
    else
        key=""
    fi

    # Get auth token and declared context window for Anthropic protocol.
    # max_ctx stays empty under the openai protocol: CLAUDE_CODE_* variables
    # only mean anything when ANTHROPIC_BASE_URL points at this provider.
    local max_ctx=""
    if [[ "$protocol" == "anthropic" ]]; then
        get_provider_value "PROVIDER_AUTH_TOKENS" "$provider"; auth_token_var="$__LLM_REPLY"
        if [[ -n "$auth_token_var" ]]; then
            get_var_value "$auth_token_var"; auth_token="$__LLM_REPLY"
        fi
        get_provider_value "PROVIDER_MAX_CONTEXT_TOKENS" "$provider"; max_ctx="$__LLM_REPLY"
    fi

    debug "Resolving environment for provider $provider:"
    debug "  protocol=$protocol"
    debug "  key_var=$key_var"
    debug "  auth_token_var=$auth_token_var"
    debug "  base=$base"
    debug "  model=$model"
    local key_set="no" auth_token_set="no"
    [[ -n "$key" ]] && key_set="yes"
    [[ -n "$auth_token" ]] && auth_token_set="yes"
    debug "  key_set=$key_set"
    debug "  auth_token_set=$auth_token_set"

    # For anthropic protocol, either api_key_var or auth_token_var is sufficient
    if [[ "$protocol" == "anthropic" ]]; then
        if [[ -z "$key_var" && -z "$auth_token_var" ]]; then
            echo "❌ Invalid provider configuration: missing api_key_var or auth_token_var for $provider"
            echo
            return 1
        fi
        if [[ -z "$key" && -z "$auth_token" ]]; then
            local missing_vars=""
            [[ -n "$key_var" && -z "$key" ]] && missing_vars="$key_var"
            [[ -n "$auth_token_var" && -z "$auth_token" ]] && {
                [[ -n "$missing_vars" ]] && missing_vars="$missing_vars or "
                missing_vars="${missing_vars}${auth_token_var}"
            }
            echo "⚠️  No credentials found for $provider. Set $missing_vars in your shell profile."
            local signup_url
            get_provider_value "PROVIDER_SIGNUP_URLS" "$provider"; signup_url="$__LLM_REPLY"
            if [[ -n "$signup_url" ]]; then
                printf '   🔑 Get an API key: %s\n' "$(link "$signup_url" "$signup_url")"
            fi
            echo
            return 1
        fi
    else
        # OpenAI protocol requires api_key_var
        if [[ -z "$key_var" ]]; then
            echo "❌ Invalid provider configuration: missing API key variable for $provider"
            echo
            return 1
        elif [[ -z "$key" ]]; then
            echo "⚠️  No API key found for $provider. Set $key_var in your shell profile."
            local signup_url
            get_provider_value "PROVIDER_SIGNUP_URLS" "$provider"; signup_url="$__LLM_REPLY"
            if [[ -n "$signup_url" ]]; then
                printf '   🔑 Get an API key: %s\n' "$(link "$signup_url" "$signup_url")"
            fi
            echo
            return 1
        fi
    fi

    if [[ -z "$base" || -z "$model" ]]; then
        echo "❌ Missing base URL or model for $provider"
        echo
        return 1
    fi

    # Export protocol-specific variables.
    #
    # Clear the OTHER protocol first. Previously each branch only exported its
    # own variables, so `set openai` after an Anthropic provider left
    # ANTHROPIC_BASE_URL, ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN and the
    # CLAUDE_CODE_* model overrides still exported -- and Claude Code reads
    # those, so it kept routing to the previous host after the user believed
    # they had switched.
    # __LLM_SET_ADDITIVE is set by set_multiple_providers, which clears both
    # protocols ONCE before its loop. A group like
    # [group:x] providers=openai_x,anth_x exists precisely to configure both
    # protocols at the same time, so the members must not clear each other.
    local host
    if [[ "$protocol" == "anthropic" ]]; then
        if [[ "${__LLM_SET_ADDITIVE:-0}" != "1" ]]; then
            _clear_protocol_env openai
            # Clear this protocol's own credentials too, so nothing from a
            # previously-set provider can survive into this one. Without this,
            # ${ANTHROPIC_API_KEY:-$auth_token} below silently preserved the
            # previous provider's key and sent it to this provider's endpoint.
            _clear_protocol_env anthropic
        fi

        # Export Anthropic-specific variables (only set what's configured)
        export ANTHROPIC_BASE_URL="$base"
        export ANTHROPIC_MODEL="$model"
        # Set Claude Code specific model variables to the provider's model
        export ANTHROPIC_DEFAULT_OPUS_MODEL="$model"
        export ANTHROPIC_DEFAULT_SONNET_MODEL="$model"
        export ANTHROPIC_DEFAULT_HAIKU_MODEL="$model"
        export CLAUDE_CODE_SUBAGENT_MODEL="$model"
        export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-false}"

        # `else unset`, not a bare conditional export. Inside a group,
        # set_multiple_providers clears both protocols ONCE and sets
        # __LLM_SET_ADDITIVE=1, so members never clear each other. Every
        # variable above survives that because it is exported unconditionally
        # and simply overwrites; a value that is only exported *sometimes* has
        # no such backstop, so a member declaring max_context_tokens would
        # leave its window standing against the next member's model.
        local ctx_report=""
        if [[ -n "$max_ctx" ]]; then
            export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$max_ctx"
            ctx_report=", CLAUDE_CODE_MAX_CONTEXT_TOKENS=$max_ctx"
        else
            unset CLAUDE_CODE_MAX_CONTEXT_TOKENS
        fi

        if [[ -n "$key" ]]; then
            export ANTHROPIC_API_KEY="$key"
        fi
        if [[ -n "$auth_token" ]]; then
            export ANTHROPIC_AUTH_TOKEN="$auth_token"
            # Fall back to the auth token only when THIS provider supplied no
            # api_key. The previous ${ANTHROPIC_API_KEY:-$auth_token} form read
            # a variable that a previously-set provider may have exported, so
            # provider A's key was sent to provider B's endpoint.
            if [[ -z "$key" ]]; then
                export ANTHROPIC_API_KEY="$auth_token"
            fi
        fi
        # Third-party Anthropic-compatible gateways (e.g. synthetic, alibaba)
        # authenticate via the Authorization: Bearer header, which Claude Code
        # populates from ANTHROPIC_AUTH_TOKEN. Bundled provider configs only
        # declare api_key_var, so ANTHROPIC_AUTH_TOKEN would otherwise stay
        # unset and those gateways reject the request. Mirror the API key into
        # the auth token when no explicit auth_token was configured. Skip the
        # real Anthropic API (api.anthropic.com): it expects the sk-ant-* key
        # via the x-api-key header, and sending it as a Bearer token can fail.
        host=$(host_from_url "$ANTHROPIC_BASE_URL")
        if [[ -z "$auth_token" && -n "${ANTHROPIC_API_KEY:-}" && "$host" != "api.anthropic.com" ]]; then
            export ANTHROPIC_AUTH_TOKEN="$ANTHROPIC_API_KEY"
            debug "  mirrored ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN (host=$host)"
        fi
        export LLM_PROVIDER="$provider"
        export LLM_PROTOCOL="$protocol"

        local cred_display=""
        [[ -n "$key" ]] && cred_display="key=$(mask "$key")"
        [[ -n "$auth_token" ]] && {
            [[ -n "$cred_display" ]] && cred_display="$cred_display "
            cred_display="${cred_display}auth_token=$(mask "$auth_token")"
        }
        echo "✅ Set: provider=$LLM_PROVIDER protocol=$protocol host=$host model=$ANTHROPIC_MODEL $cred_display"
        # $ctx_report is empty unless the provider declared max_context_tokens,
        # so this line stays byte-identical for every provider that does not.
        echo "🔧 Additional Claude Code variables set: ANTHROPIC_DEFAULT_OPUS_MODEL=$ANTHROPIC_DEFAULT_OPUS_MODEL, ANTHROPIC_DEFAULT_SONNET_MODEL=$ANTHROPIC_DEFAULT_SONNET_MODEL, ANTHROPIC_DEFAULT_HAIKU_MODEL=$ANTHROPIC_DEFAULT_HAIKU_MODEL, CLAUDE_CODE_SUBAGENT_MODEL=$CLAUDE_CODE_SUBAGENT_MODEL${ctx_report}"
    else
        if [[ "${__LLM_SET_ADDITIVE:-0}" != "1" ]]; then
            _clear_protocol_env anthropic
            _clear_protocol_env openai
        fi

        # Export OpenAI-compatible variables (default)
        export OPENAI_API_KEY="$key"
        export OPENAI_BASE_URL="$base"
        export OPENAI_MODEL="$model"
        export LLM_PROVIDER="$provider"
        export LLM_PROTOCOL="$protocol"

        host=$(host_from_url "$OPENAI_BASE_URL")
        echo "✅ Set: provider=$LLM_PROVIDER protocol=$protocol host=$host model=$OPENAI_MODEL key=$(mask "$OPENAI_API_KEY")"
    fi
    return 0
}

# Set multiple providers from a comma-separated list
set_multiple_providers() {
    local provider_list="$1"
    local failed=0
    local count=0

    # Clear both protocols ONCE, then let the members accumulate. A group's
    # whole purpose is to configure openai and anthropic simultaneously, so
    # per-member clearing would leave only the last one standing -- but we
    # still must not inherit a previously-set provider's variables.
    _clear_protocol_env openai
    _clear_protocol_env anthropic
    __LLM_SET_ADDITIVE=1

    # Split comma-separated list and set each provider
    local provider
    while IFS= read -r provider; do
        # Trim whitespace
        trim "$provider"; provider="$__LLM_REPLY"
        [[ -z "$provider" ]] && continue
        count=$((count + 1))
        if ! set_single_provider "$provider"; then
            failed=$((failed + 1))
        fi
    done <<< "$(echo "$provider_list" | tr ',' '\n')"
    unset __LLM_SET_ADDITIVE

    if [[ "$failed" -eq 0 && "$count" -gt 1 ]]; then
        # Multi-provider set: LLM_PROVIDER shows the whole list.
        # Gated on failed==0, not just count>1. Previously a group whose
        # providers had all failed still exported LLM_PROVIDER, so `show`
        # reported an active provider that had no credentials.
        export LLM_PROVIDER="$provider_list"
    elif [[ "$failed" -ne 0 && "$count" -gt 1 ]]; then
        # A partially- or wholly-failed group must not leave a stale
        # LLM_PROVIDER from an earlier successful set.
        if [[ "$failed" -eq "$count" ]]; then
            unset LLM_PROVIDER
        fi
    fi

    echo
    [[ "$failed" -eq 0 ]] && return 0 || return 1
}

cmd_set() {
    local input="$1"
    if [[ -z "$input" ]]; then
        echo "Usage: source llm-env set <provider|group|provider1,provider2>"
        echo "Available providers: ${AVAILABLE_PROVIDERS[*]-}"
        if [[ ${#AVAILABLE_GROUPS[@]} -gt 0 ]]; then
            echo "Available groups: ${AVAILABLE_GROUPS[*]-}"
        fi
        echo
        return 1
    fi

    # Check if input is a group name
    local group_providers
    get_provider_value "PROVIDER_GROUPS" "$input"; group_providers="$__LLM_REPLY"
    if [[ -n "$group_providers" ]]; then
        debug "Setting group '$input' with providers: $group_providers"
        set_multiple_providers "$group_providers"
        return $?
    fi

    # Check if input contains commas (multi-provider set)
    if [[ "$input" == *,* ]]; then
        debug "Setting comma-separated providers: $input"
        set_multiple_providers "$input"
        return $?
    fi

    # Single provider
    set_single_provider "$input"
    local rc=$?
    echo
    return $rc
}

cmd_unset() {
    # Check if anything is actually set
    local has_openai=false has_anthropic=false
    [[ -n "${OPENAI_BASE_URL:-}" || -n "${OPENAI_MODEL:-}" || -n "${OPENAI_API_KEY:-}" ]] && has_openai=true
    [[ -n "${ANTHROPIC_BASE_URL:-}" || -n "${ANTHROPIC_MODEL:-}" || -n "${ANTHROPIC_API_KEY:-}" || -n "${ANTHROPIC_AUTH_TOKEN:-}" ]] && has_anthropic=true

    if [[ -z "${LLM_PROVIDER:-}" && "$has_openai" == false && "$has_anthropic" == false ]]; then
        echo "ℹ️  Nothing to unset — no LLM environment variables are currently set."
        echo
        return 0
    fi

    local prev_p="${LLM_PROVIDER:-}"
    local prev_protocol="${LLM_PROTOCOL:-openai}"

    # Capture previous state for both protocols
    local prev_openai_host prev_openai_model prev_anthropic_host prev_anthropic_model
    prev_openai_host=$(host_from_url "${OPENAI_BASE_URL:-}")
    prev_openai_model="${OPENAI_MODEL:-}"
    prev_anthropic_host=$(host_from_url "${ANTHROPIC_BASE_URL:-}")
    prev_anthropic_model="${ANTHROPIC_MODEL:-}"

    # Unset everything llm-env owns, from the same lists set_single_provider
    # uses, so set and unset cannot disagree about the managed surface.
    #
    # Two deliberate changes from the previous hand-written list:
    #   * CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is no longer unset. set only
    #     DEFAULTS it (via :-false) rather than owning it, so unsetting it
    #     destroyed a value the user had put in their own profile.
    #   * OPENAI_MODEL_OVERRIDE is now unset. It is documented in cmd_help and
    #     honoured by set_single_provider, but was never cleared -- so it kept
    #     silently overriding the model on every subsequent set.
    _clear_protocol_env openai
    _clear_protocol_env anthropic
    local __v
    __llm_split "$LLM_MANAGED_VARS_COMMON"
    for __v in ${__LLM_WORDS[@]+"${__LLM_WORDS[@]}"}; do
        unset "$__v"
    done

    echo "🗑️ Unset LLM environment variables."
    if [[ -n "$prev_p" ]]; then
        echo "   Provider : $prev_p (protocol: $prev_protocol)"
    fi
    if [[ "$has_openai" == true ]]; then
        echo "   OpenAI   : host=${prev_openai_host:-∅} model=${prev_openai_model:-∅}"
    fi
    if [[ "$has_anthropic" == true ]]; then
        echo "   Anthropic: host=${prev_anthropic_host:-∅} model=${prev_anthropic_model:-∅}"
    fi
    echo
}

cmd_list() {
    local show_all=false
    [[ "$1" == "--all" ]] && show_all=true

    # Reload configuration to ensure we have the latest providers
    init_config

    echo "Available providers:"
    echo

    local providers_to_show=()
    if $show_all; then
        # Show all providers (enabled and disabled)
        get_provider_keys "PROVIDER_BASE_URLS"
        local _p
        for _p in ${__LLM_REPLY_KEYS[@]+"${__LLM_REPLY_KEYS[@]}"}; do
            [[ -n "$_p" ]] && providers_to_show+=("$_p")
        done
    else
        # Show only enabled providers
        providers_to_show=(${AVAILABLE_PROVIDERS[@]+"${AVAILABLE_PROVIDERS[@]}"})
    fi

    # Declare loop variables outside the loop for zsh compatibility
    local mark base model key_var have_key description enabled_status provider_enabled protocol key_val
    for provider in ${providers_to_show[@]+"${providers_to_show[@]}"}; do
        mark=" "
        [[ "$provider" == "${LLM_PROVIDER:-}" ]] && mark="*"

        get_provider_value "PROVIDER_BASE_URLS" "$provider"; base="$__LLM_REPLY"
        get_provider_value "PROVIDER_DEFAULT_MODELS" "$provider"; model="$__LLM_REPLY"
        get_provider_value "PROVIDER_API_KEY_VARS" "$provider"; key_var="$__LLM_REPLY"
        get_provider_value "PROVIDER_DESCRIPTIONS" "$provider"; description="$__LLM_REPLY"
        get_provider_value "PROVIDER_PROTOCOLS" "$provider"; protocol="${__LLM_REPLY:-openai}"

        have_key="no"
        if [[ -n "$key_var" ]]; then
            get_var_value "$key_var"; key_val="$__LLM_REPLY"
            [[ -n "$key_val" ]] && have_key="yes"
        fi

        # Show disabled status if showing all providers
        enabled_status=""
        get_provider_value "PROVIDER_ENABLED" "$provider"; provider_enabled="$__LLM_REPLY"
        if $show_all && [[ "${provider_enabled:-true}" != "true" ]]; then
            enabled_status=" (disabled)"
        fi

        printf " %s %-12s  %-9s  %-30s  %-24s  key:%-3s  %s%s\n" \
            "$mark" "$provider" "$protocol" "$base" "$model" "$have_key" "$description" "$enabled_status"
    done
    [[ -n "${LLM_PROVIDER:-}" ]] && echo; echo "* current provider"

    # Show groups if any are defined
    if [[ ${#AVAILABLE_GROUPS[@]} -gt 0 ]]; then
        echo
        echo "Provider groups:"
        echo
        local group_name group_providers
        for group_name in ${AVAILABLE_GROUPS[@]+"${AVAILABLE_GROUPS[@]}"}; do
            get_provider_value "PROVIDER_GROUPS" "$group_name"; group_providers="$__LLM_REPLY"
            printf "   %-12s  → %s\n" "$group_name" "$group_providers"
        done
    fi

    echo
    return 0  # Explicit success return
}

cmd_show() {
    local current_protocol="${LLM_PROTOCOL:-openai}"

    # Detect which protocols have variables set
    local has_openai=false has_anthropic=false
    [[ -n "${OPENAI_BASE_URL:-}" || -n "${OPENAI_MODEL:-}" || -n "${OPENAI_API_KEY:-}" ]] && has_openai=true
    [[ -n "${ANTHROPIC_BASE_URL:-}" || -n "${ANTHROPIC_MODEL:-}" || -n "${ANTHROPIC_API_KEY:-}" || -n "${ANTHROPIC_AUTH_TOKEN:-}" ]] && has_anthropic=true

    echo "Current environment:"
    echo "  LLM_PROVIDER       = ${LLM_PROVIDER:-∅}"
    echo "  LLM_PROTOCOL       = ${current_protocol}"

    # Show OpenAI variables if set, or if it's the active protocol
    if [[ "$has_openai" == true || "$current_protocol" == "openai" ]]; then
        echo "  OPENAI_BASE_URL    = ${OPENAI_BASE_URL:-∅}"
        echo "  OPENAI_MODEL       = ${OPENAI_MODEL:-∅}"
        echo "  OPENAI_API_KEY     = $(mask "${OPENAI_API_KEY:-}")"
    fi

    # Show Anthropic variables if set, or if it's the active protocol
    if [[ "$has_anthropic" == true || "$current_protocol" == "anthropic" ]]; then
        echo "  ANTHROPIC_BASE_URL = ${ANTHROPIC_BASE_URL:-∅}"
        echo "  ANTHROPIC_MODEL    = ${ANTHROPIC_MODEL:-∅}"
        echo "  ANTHROPIC_API_KEY  = $(mask "${ANTHROPIC_API_KEY:-}")"
        echo "  ANTHROPIC_AUTH_TOKEN = $(mask "${ANTHROPIC_AUTH_TOKEN:-}")"
        # Shown only when the provider declared max_context_tokens. Printing
        # a placeholder would imply llm-env manages a window for every
        # provider, when most correctly leave Claude Code to its own default.
        # Deliberately not padded to the = column: the name is 30 characters
        # and would push every line above it out of alignment.
        if [[ -n "${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-}" ]]; then
            echo "  CLAUDE_CODE_MAX_CONTEXT_TOKENS = ${CLAUDE_CODE_MAX_CONTEXT_TOKENS}"
        fi
    fi

    # Show configuration source
    while IFS=$'\t' read -r _tier config_file; do
        if [[ -f "$config_file" ]]; then
            echo "  Config file        = $config_file"
            break
        fi
    done < <(get_config_locations)
    echo
}

cmd_config() {
    local subcmd="$1"
    shift
    
    case "$subcmd" in
        init)
            cmd_config_init "$@"
            ;;
        edit)
            cmd_config_edit "$@"
            ;;
        add)
            cmd_config_add "$@"
            ;;
        remove)
            cmd_config_remove "$@"
            ;;
        validate)
            cmd_config_validate "$@"
            ;;
        backup)
            cmd_config_backup "$@"
            ;;
        restore)
            cmd_config_restore "$@"
            ;;
        bulk)
            cmd_config_bulk "$@"
            ;;
        *)
            echo "Usage: source llm-env config {init|edit|add|remove|validate|backup|restore|bulk}"
            echo "  init              Create user configuration file"
            echo "  edit              Edit user configuration file"
            echo "  add <provider>    Add a new provider interactively"
            echo "  remove <provider> Remove a provider"
            echo "  validate          Validate configuration file"
            echo "  backup            Create a backup of configuration"
            echo "  restore <file>    Restore configuration from backup"
            echo "  bulk <action> <providers...>  Perform bulk operations (enable|disable)"
            ;;
    esac
}

cmd_config_init() {
    local user_config
    user_config="$(get_user_config_path)"

    if [[ -f "$user_config" ]]; then
        echo "⚠️  Configuration file already exists: $user_config"
        read -p "Overwrite? (y/N): " -n 1 -r
        echo
        echo
        local yes_pattern="^[Yy]$"
        # $REPLY here is the `read` builtin's own output slot, deliberately NOT
        # the accessors' __LLM_REPLY. They used to be the same variable, so a
        # failed `read` (zsh has no -p/-n) left whatever value an accessor had
        # last written -- and a config value of "y" silently answered the
        # prompt. If `read` fails now, $REPLY is empty and this aborts.
        [[ ! $REPLY =~ $yes_pattern ]] && return 1
    fi

    # Create directory if it doesn't exist
    mkdir -p "$(dirname "$user_config")"

    # Try to copy from system/repo config first (excluding user config path)
    local default_config=""
    local script_dir_config
    script_dir_config="$(get_script_dir)/config/llm-env.conf"

    if [[ -f "/usr/local/etc/llm-env/config.conf" ]]; then
        default_config="/usr/local/etc/llm-env/config.conf"
    elif [[ -f "$script_dir_config" ]]; then
        default_config="$script_dir_config"
    fi

    if [[ -n "$default_config" ]]; then
        cp "$default_config" "$user_config"
        echo "✅ Created user configuration: $user_config"
        echo "💡 Edit this file to customize your providers and models"
        echo
    else
        # Generate default config inline (matches installer behavior)
        cat > "$user_config" << 'EOF'
# LLM Environment Manager Configuration
# This file defines available LLM providers and their settings

[openai]
base_url=https://api.openai.com/v1
api_key_var=LLM_OPENAI_API_KEY
default_model=gpt-5
description=Industry standard, highest quality
enabled=true

[cerebras]
base_url=https://api.cerebras.ai/v1
api_key_var=LLM_CEREBRAS_API_KEY
default_model=qwen-3-coder-480b
description=Fast inference, great for coding
enabled=true

[groq]
base_url=https://api.groq.com/openai/v1
api_key_var=LLM_GROQ_API_KEY
default_model=openai/gpt-oss-120b
description=Lightning-fast inference
enabled=true

[openrouter]
base_url=https://openrouter.ai/api/v1
api_key_var=LLM_OPENROUTER_API_KEY
default_model=deepseek/deepseek-chat-v3.1:free
description=Free tier option
enabled=true

[xai]
base_url=https://api.x.ai/v1
api_key_var=LLM_XAI_API_KEY
default_model=grok-code-fast-1
description=xAI Grok, excellent reasoning and coding capabilities
enabled=false

[deepseek]
base_url=https://api.deepseek.com/v1
api_key_var=LLM_DEEPSEEK_API_KEY
default_model=deepseek-chat
description=DeepSeek, excellent coding and reasoning models
enabled=false
EOF
        echo "✅ Created user configuration: $user_config"
        echo "💡 Edit this file to customize your providers and models"
        echo
    fi
}

cmd_config_edit() {
    local user_config
    user_config="$(get_user_config_path)"
    
    if [[ ! -f "${user_config}" ]]; then
        echo "⚠️  User configuration not found. Creating it first..."
        echo
        cmd_config_init || return 1
    fi
    
    # Use user's preferred editor
    local editor="${EDITOR:-${VISUAL:-nano}}"
    "$editor" "$user_config"
    
    echo "💡 Run 'source llm-env config validate' to check your configuration"
    echo
}

cmd_config_add() {
    local provider="$1"
    if [[ -z "$provider" ]]; then
        echo "Usage: source llm-env config add <provider_name>"
        return 1
    fi
    
    # Validate provider name format
    if ! validate_provider_name "$provider"; then
        return 1
    fi
    
    echo "Adding new provider: $provider"
    echo "Please provide the following information:"
    
    # Set timeout for read operations
    local TMOUT=30
    read -r -t $TMOUT -p "Base URL: " base_url || { echo "Timeout reached"; return 1; }
    read -r -t $TMOUT -p "API Key Environment Variable: " api_key_var || { echo "Timeout reached"; return 1; }
    read -r -t $TMOUT -p "Default Model: " default_model || { echo "Timeout reached"; return 1; }
    read -r -t $TMOUT -p "Description (optional): " description || { echo "Timeout reached"; return 1; }
    
    # Validate rather than mutate. sanitize_config_value used to strip & $ ; |
    # here, corrupting any URL with a query string while missing the apostrophe
    # that was the actual injection vector. A newline would let a value forge a
    # new [section] when written to the config, so reject that outright.
    local field
    for field in base_url api_key_var default_model description; do
        get_var_value "$field"
        case "$__LLM_REPLY" in
            *$'\n'*|*$'\r'*)
                echo "❌ $field may not contain a newline." >&2
                return 1
                ;;
        esac
    done
    if [[ -n "$api_key_var" ]] && ! [[ "$api_key_var" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        echo "❌ API key variable '$api_key_var' is not a valid environment variable name." >&2
        return 1
    fi

    local user_config
    user_config="$(get_user_config_path)"
    
    # Create user config if it doesn't exist
    if [[ ! -f "$user_config" ]]; then
        cmd_config_init || return 1
    fi

    # Refuse a duplicate rather than appending a second [provider] section.
    # Two sections with the same name meant the later one silently won at load
    # time while the earlier sat there as dead weight. _qs_emit_provider has
    # always checked this; config add did not.
    if grep -qFx "[$provider]" "$user_config"; then
        echo "❌ Provider '$provider' already exists in $user_config" >&2
        echo "   Use 'config remove $provider' first, or pick another name." >&2
        return 1
    fi

    # Required fields must be non-empty, otherwise load_config drops the
    # provider with only a debug message and the user never learns why.
    if [[ -z "$base_url" || -z "$api_key_var" || -z "$default_model" ]]; then
        echo "❌ base_url, api_key_var and default_model are all required." >&2
        return 1
    fi

    # Append new provider
    {
        echo ""
        echo "[$provider]"
        echo "base_url=$base_url"
        echo "api_key_var=$api_key_var"
        echo "default_model=$default_model"
        [[ -n "$description" ]] && echo "description=$description"
        echo "enabled=true"
    } >> "$user_config"
    
    echo "✅ Added provider '$provider' to $user_config"
    echo "💡 Don't forget to set $api_key_var in your shell profile"
}

cmd_config_remove() {
    local provider="$1"
    if [[ -z "$provider" ]]; then
        echo "Usage: source llm-env config remove <provider_name>"
        return 1
    fi
    
    # Accept "group:name" as well as a plain provider. Group sections were
    # previously unremovable, so quickstart-created groups accumulated forever.
    local section_kind="provider" section_name="$provider"
    case "$provider" in
        group:*)
            section_kind="group"
            section_name="${provider#group:}"
            if ! _llm_id_is_safe "$section_name"; then
                echo "Error: Invalid group name '$section_name'." >&2
                return 1
            fi
            ;;
        *)
            if ! validate_provider_name "$provider"; then
                return 1
            fi
            ;;
    esac

    local user_config
    user_config="$(get_user_config_path)"

    if [[ ! -f "$user_config" ]]; then
        echo "❌ User configuration not found: $user_config"
        return 1
    fi

    # Refuse rather than report a phantom success. This used to print
    # "✅ Removed" unconditionally, so a typo looked like a removal.
    if ! grep -qFx "[$provider]" "$user_config"; then
        echo "❌ No such $section_kind in $user_config: $provider" >&2
        return 1
    fi

    local backup
    backup="$(_config_backup_file "$user_config")" || {
        echo "❌ Could not create a backup; refusing to modify the config." >&2
        return 1
    }

    # Also drops the "# <description>" comment _qs_emit_provider writes
    # directly above each section, which otherwise accumulated as orphans.
    # $0 below is awk's own field variable and must NOT be expanded by the
    # shell; the section name is passed in safely via -v.
    # shellcheck disable=SC2016
    if ! _config_atomic_write "$user_config" awk -v section="[$provider]" '
        BEGIN { in_section = 0; pending = "" }
        {
            line = $0
            sub(/\r$/, "", line)
        }
        line ~ /^\[/ {
            if (line == section) { in_section = 1; pending = ""; next }
            in_section = 0
            if (pending != "") { print pending; pending = "" }
            print
            next
        }
        in_section { next }
        # Hold a lone comment: it belongs to whatever section follows.
        line ~ /^#/ && pending == "" { pending = $0; next }
        {
            if (pending != "") { print pending; pending = "" }
            print
        }
        END { if (pending != "") print pending }
    '; then
        echo "❌ Failed to rewrite $user_config; it is unchanged." >&2
        echo "   A backup of the current contents is at $backup" >&2
        return 1
    fi

    # Refresh the in-memory view so `list` does not keep showing the removal.
    init_config >/dev/null 2>&1 || true

    echo "✅ Removed $section_kind '$provider' from $user_config"
    echo "💡 Backup saved as $backup"
}

cmd_test() {
    local provider="$1"
    if [[ -z "$provider" ]]; then
        echo "Usage: source llm-env test <provider>"
        echo "Available providers: ${AVAILABLE_PROVIDERS[*]-}"
        return 1
    fi

    # Validate provider name format
    if ! validate_provider_name "$provider"; then
        return 1
    fi

    # Validate provider
    validate_provider "$provider"
    local validate_result=$?
    if [[ $validate_result -ne 0 ]]; then
        case $validate_result in
            1) echo "❌ Unknown provider: $provider" ;;
            2) echo "❌ Provider disabled: $provider" ;;
        esac
        echo "Available providers: ${AVAILABLE_PROVIDERS[*]-}"
        return 1
    fi

    # Get protocol for this provider (defaults to "openai")
    local protocol
    get_provider_value "PROVIDER_PROTOCOLS" "$provider"; protocol="${__LLM_REPLY:-openai}"

    echo "🧪 Testing provider: $provider (protocol: $protocol)"

    local key_var base_url api_key auth_token_var auth_token
    get_provider_value "PROVIDER_API_KEY_VARS" "$provider"; key_var="$__LLM_REPLY"
    get_provider_value "PROVIDER_BASE_URLS" "$provider"; base_url="$__LLM_REPLY"
    if [[ -n "$key_var" ]]; then
        get_var_value "$key_var"; api_key="$__LLM_REPLY"
    else
        api_key=""
    fi

    # Get auth token for Anthropic protocol
    auth_token_var=""
    auth_token=""
    if [[ "$protocol" == "anthropic" ]]; then
        get_provider_value "PROVIDER_AUTH_TOKENS" "$provider"; auth_token_var="$__LLM_REPLY"
        if [[ -n "$auth_token_var" ]]; then
            get_var_value "$auth_token_var"; auth_token="$__LLM_REPLY"
        fi
    fi

    # Use auth_token as api_key fallback for anthropic protocol
    if [[ -z "$api_key" && -n "$auth_token" ]]; then
        api_key="$auth_token"
        key_var="$auth_token_var"
    fi

    # Check if API key is available
    if [[ -z "$api_key" ]]; then
        local missing_vars=""
        if [[ "$protocol" == "anthropic" ]]; then
            [[ -n "$key_var" ]] && missing_vars="$key_var"
            [[ -n "$auth_token_var" ]] && {
                [[ -n "$missing_vars" ]] && missing_vars="$missing_vars or "
                missing_vars="${missing_vars}${auth_token_var}"
            }
        else
            missing_vars="$key_var"
        fi
        echo "❌ $provider: API key not found (protocol: $protocol)"
        echo "💡 Set $missing_vars in your environment."
        echo
        return 1
    fi

    echo "✅ API key found: $(mask "$api_key")"
    echo
    echo "🔗 Base URL: $base_url"

    # Determine endpoint and auth headers based on protocol
    local test_endpoint
    # curl reads its headers from stdin via --config so the API key never
    # enters argv, where ps and /proc/<pid>/cmdline expose it on a shared host.
    # auth_headers is retained only for the wget fallback and debug output,
    # with the credential redacted.
    local -a auth_headers curl_cfg_lines
    # Strip trailing slash from base_url if present
    base_url="${base_url%/}"

    if [[ "$protocol" == "anthropic" ]]; then
        # Anthropic uses x-api-key header
        # If base_url already ends with /v1, append /messages; otherwise append /v1/messages
        if [[ "$base_url" == */v1 ]]; then
            test_endpoint="${base_url}/messages"
        else
            test_endpoint="${base_url}/v1/messages"
        fi
        auth_headers=(-H "x-api-key: <redacted>" -H "anthropic-version: 2023-06-01")
        curl_cfg_lines=(
            "url = \"$test_endpoint\""
            "header = \"x-api-key: $api_key\""
            "header = \"anthropic-version: 2023-06-01\""
            "header = \"Content-Type: application/json\""
        )
    else
        # OpenAI uses Authorization: Bearer header
        # Endpoint: base_url/models
        test_endpoint="${base_url}/models"
        auth_headers=(-H "Authorization: Bearer <redacted>")
        curl_cfg_lines=(
            "url = \"$test_endpoint\""
            "header = \"Authorization: Bearer $api_key\""
            "header = \"Content-Type: application/json\""
        )
    fi

    echo "🌐 Testing connectivity to: $test_endpoint"

    local start_time
    start_time="$(__llm_now_ms)"
    local response

    # Use curl or wget to test API endpoint
    if command -v curl >/dev/null 2>&1; then
        # Headers go in on stdin via --config, NOT in argv. As -H arguments the
        # API key was visible to any process that could read ps output or
        # /proc/<pid>/cmdline on a shared host.
        #
        # -L follows redirects: a provider that 30x's /models otherwise
        # reported "Unexpected response".
        response=$(printf '%s\n' "${curl_cfg_lines[@]}" \
            | curl -s -L -w "%{http_code}" -o /dev/null \
                   --max-time 10 --config - 2>/dev/null)
    elif command -v wget >/dev/null 2>&1; then
        # Construct wget headers
        local wget_headers=()
        if [[ "$protocol" == "anthropic" ]]; then
            wget_headers+=("--header=x-api-key: $api_key" "--header=anthropic-version: 2023-06-01")
        else
            wget_headers+=("--header=Authorization: Bearer $api_key")
        fi
        wget_headers+=("--header=Content-Type: application/json")
        
        # wget prints server response headers to stderr with --server-response (-S)
        # We capture stderr, grep for HTTP status code
        local wget_out
        wget_out=$(wget -q -S -O /dev/null --timeout=10 ${wget_headers[@]+"${wget_headers[@]}"} "$test_endpoint" 2>&1)
        
        # Extract the last HTTP status code
        response=$(echo "$wget_out" | grep "HTTP/" | tail -1 | awk '{print $2}')
    else
        echo "❌ neither curl nor wget found. Please install one to test API connectivity."
        echo
        return 1
    fi

    local end_time duration
    end_time="$(__llm_now_ms)"
    duration="$(__llm_fmt_duration "$start_time" "$end_time")"

    # curl -w '%{http_code}' prints 000 when it never got a response at all
    # (DNS failure, refused connection, timeout). That is a connection error,
    # not an HTTP status -- treating it as one made the empty-string arm below
    # unreachable and reported an unreachable host as exit 0. wget yields an
    # empty string in the same situation, so normalise both here and let the
    # single arm handle it.
    case "$response" in
        000|"") response="" ;;
    esac

    case "$response" in
        200)
            echo "✅ $provider: Connected successfully (protocol: $protocol)"
            echo
            echo "⏱️ Response time: ${duration}s"
            ;;
        401)
            echo "❌ $provider: Authentication failed (protocol: $protocol)"
            echo "💡 Check your API key: $key_var"
            echo
            return 1
            ;;
        403)
            echo "❌ $provider: Access forbidden (protocol: $protocol)"
            echo "💡 Check API key permissions"
            echo
            return 1
            ;;
        404)
            echo "⚠️  $provider: Endpoint not found (protocol: $protocol, HTTP $response)"
            echo "💡 Provider may use different API path"
            echo
            # A 404 means the endpoint under test does not exist, so the
            # connectivity check has not succeeded. This arm alone fell through
            # to exit 0, unlike 401/403/5xx, so a scripted caller could not tell
            # a misconfigured base_url from a working provider.
            return 1
            ;;
        405)
            # For Anthropic, /v1/messages returns 405 for GET requests (it requires POST)
            # This still confirms the endpoint exists and auth headers are valid
            if [[ "$protocol" == "anthropic" ]]; then
                echo "✅ $provider: Connected successfully (protocol: $protocol)"
                echo "💡 Anthropic messages endpoint verified (requires POST for full test)"
                echo
                echo "⏱️ Response time: ${duration}s"
            else
                echo "⚠️  $provider: Method not allowed (protocol: $protocol, HTTP $response)"
                echo
            fi
            ;;
        429)
            echo "⚠️  $provider: Rate limited (protocol: $protocol)"
            echo "💡 Please try again later"
            echo
            return 1
            ;;
        "")
            echo "❌ $provider: Connection timeout or network error (protocol: $protocol)"
            echo "💡 Check internet connection and base URL"
            echo
            return 1
            ;;
        5*)
            echo "❌ $provider: Server error (protocol: $protocol, HTTP $response)"
            echo
            return 1
            ;;
        *)
            echo "⚠️  $provider: Unexpected response (protocol: $protocol, HTTP $response)"
            echo "💡 Provider may have different API format"
            echo
            ;;
    esac

    echo "🏁 Test completed for provider: $provider"
    echo
}

# --- Quickstart v2 helpers ---------------------------------------------------
#
# These pure-bash helpers parse the quickstart-{synthetic,alibaba}.json files
# in schema v2. They avoid jq to keep the project's zero-runtime-deps ethos.

# Extract a top-level JSON string scalar by key from a JSON document.
# Usage: _qs_json_string "$json" "schema_version"
# Echoes the value (without quotes), or empty string if not found.
# Scan the JSON string literal that starts at index $2 of $1 (which must be the
# opening quote). Sets __LLM_REPLY to the unescaped value and __LLM_JSON_END to
# the index just past the closing quote. Returns 1 on an unterminated string.
#
# Escape awareness is the whole point: the previous grep -o '"[^"]*"' form
# stopped at the first quote regardless of a preceding backslash, so any value
# containing \" was truncated mid-word and the remains -- often ending in a
# dangling backslash -- were written into the user's config.
_qs_scan_string() {
    local s="$1" i="$2"
    local n=${#s} ch out="" esc=false
    i=$((i + 1))
    while [[ $i -lt $n ]]; do
        ch="${s:$i:1}"
        if [[ "$esc" == true ]]; then
            case "$ch" in
                n)  out="${out}"$'\n' ;;
                t)  out="${out}"$'\t' ;;
                r)  out="${out}"$'\r' ;;
                b)  out="${out}"$'\b' ;;
                f)  out="${out}"$'\f' ;;
                # \uXXXX is passed through literally: llm-env never needs to
                # render it, and decoding would require more machinery than a
                # config-file value warrants.
                u)  out="${out}\\u" ;;
                *)  out="${out}${ch}" ;;
            esac
            esc=false
        elif [[ "$ch" == "\\" ]]; then
            esc=true
        elif [[ "$ch" == '"' ]]; then
            __LLM_REPLY="$out"
            __LLM_JSON_END=$((i + 1))
            return 0
        else
            out="${out}${ch}"
        fi
        i=$((i + 1))
    done
    return 1
}

# Advance past JSON whitespace starting at index $2 of $1; echoes the new index.
_qs_skip_ws() {
    local s="$1" i="$2" n=${#1}
    while [[ $i -lt $n ]]; do
        case "${s:$i:1}" in
            ' '|$'\t'|$'\n'|$'\r') i=$((i + 1)) ;;
            *) break ;;
        esac
    done
    printf '%s' "$i"
}

# Extract the string value for "key" from a JSON document.
# Echoes the value (empty when absent or when the value is not a string).
_qs_json_string() {
    local json="$1" key="$2"
    local target="\"$key\""
    local tlen=${#target} n=${#json} i=0 j
    while [[ $i -lt $n ]]; do
        if [[ "${json:$i:$tlen}" == "$target" ]]; then
            j="$(_qs_skip_ws "$json" $((i + tlen)))"
            if [[ "${json:$j:1}" == ":" ]]; then
                j="$(_qs_skip_ws "$json" $((j + 1)))"
                if [[ "${json:$j:1}" == '"' ]]; then
                    if _qs_scan_string "$json" "$j"; then
                        printf '%s' "$__LLM_REPLY"
                        return 0
                    fi
                fi
                # Key found but the value is not a string (number, bool, object).
                return 0
            fi
        fi
        i=$((i + 1))
    done
}

# Extract a single JSON object value by key from a top-level document.
# Echoes the object text including its surrounding braces.
# Returns empty if not found.
_qs_json_object() {
    local json="$1" key="$2"
    # Find the index of "key" in the document.
    local prefix rest depth=0 i ch out=""
    rest="${json#*\""$key"\"}"
    if [[ "$rest" == "$json" ]]; then
        # Key not present
        return 0
    fi
    # Skip past the colon to the opening brace.
    rest="${rest#*:}"
    # Strip leading whitespace.
    rest="${rest#"${rest%%[!$' \t\n\r']*}"}"
    if [[ "${rest:0:1}" != "{" ]]; then
        return 0
    fi
    # Walk the object respecting nested braces and strings.
    local in_string=false esc=false
    for (( i=0; i<${#rest}; i++ )); do
        ch="${rest:$i:1}"
        out+="$ch"
        if [[ "$in_string" == true ]]; then
            if [[ "$esc" == true ]]; then
                esc=false
            elif [[ "$ch" == "\\" ]]; then
                esc=true
            elif [[ "$ch" == '"' ]]; then
                in_string=false
            fi
            continue
        fi
        case "$ch" in
            '"') in_string=true ;;
            '{') depth=$((depth + 1)) ;;
            '}') depth=$((depth - 1))
                if [[ $depth -eq 0 ]]; then
                    printf '%s' "$out"
                    return 0
                fi
                ;;
        esac
    done
    return 0
}

# Extract a JSON array body by key from a document.
# Echoes the contents *between* the [ and ], not including the brackets.
# Returns empty if not found.
_qs_json_array_body() {
    local json="$1" key="$2"
    local rest depth=0 i ch out="" in_string=false esc=false
    rest="${json#*\""$key"\"}"
    if [[ "$rest" == "$json" ]]; then
        return 0
    fi
    rest="${rest#*:}"
    rest="${rest#"${rest%%[!$' \t\n\r']*}"}"
    if [[ "${rest:0:1}" != "[" ]]; then
        return 0
    fi
    # Skip the opening [.
    rest="${rest:1}"
    for (( i=0; i<${#rest}; i++ )); do
        ch="${rest:$i:1}"
        if [[ "$in_string" == true ]]; then
            out+="$ch"
            if [[ "$esc" == true ]]; then
                esc=false
            elif [[ "$ch" == "\\" ]]; then
                esc=true
            elif [[ "$ch" == '"' ]]; then
                in_string=false
            fi
            continue
        fi
        case "$ch" in
            '"') in_string=true; out+="$ch" ;;
            '[') depth=$((depth + 1)); out+="$ch" ;;
            ']')
                if [[ $depth -eq 0 ]]; then
                    printf '%s' "$out"
                    return 0
                fi
                depth=$((depth - 1)); out+="$ch"
                ;;
            *) out+="$ch" ;;
        esac
    done
    return 0
}

# Split an array body of objects into a NUL-delimited list of JSON objects.
# Each emitted object includes its surrounding braces. Use NUL because object
# bodies span multiple lines.
# Callers should consume with: while IFS= read -r -d '' obj; do ...; done < <(...)
_qs_split_object_array() {
    local body="$1"
    local depth=0 i ch out="" in_string=false esc=false started=false
    for (( i=0; i<${#body}; i++ )); do
        ch="${body:$i:1}"
        if [[ "$in_string" == true ]]; then
            out+="$ch"
            if [[ "$esc" == true ]]; then
                esc=false
            elif [[ "$ch" == "\\" ]]; then
                esc=true
            elif [[ "$ch" == '"' ]]; then
                in_string=false
            fi
            continue
        fi
        case "$ch" in
            '"') in_string=true; out+="$ch" ;;
            '{')
                if [[ "$started" == false ]]; then
                    started=true; out=""
                fi
                depth=$((depth + 1)); out+="$ch"
                ;;
            '}')
                depth=$((depth - 1)); out+="$ch"
                if [[ $depth -eq 0 ]]; then
                    printf '%s\0' "$out"
                    out=""
                    started=false
                fi
                ;;
            *)
                if [[ "$started" == true ]]; then
                    out+="$ch"
                fi
                ;;
        esac
    done
}

# Extract simple "key": "value" pairs from a flat JSON object.
# Emits one "key=value" per line. Skips nested objects/arrays.
# Used for family_latest-style maps.
# Emit "key=value" for every TOP-LEVEL string pair of a JSON object, one per
# line. Nested objects and arrays are skipped, as the docstring always claimed:
# the previous grep ran over the flattened text, so a nested object contributed
# its own inner pairs and produced bogus [group:*] sections in the user config.
_qs_extract_string_pairs() {
    local obj="$1"
    obj="${obj#\{}"
    obj="${obj%\}}"
    local n=${#obj} i=0 ch key depth
    while [[ $i -lt $n ]]; do
        i="$(_qs_skip_ws "$obj" "$i")"
        [[ $i -lt $n ]] || break
        ch="${obj:$i:1}"
        case "$ch" in
            ','|':') i=$((i + 1)); continue ;;
            '"')
                _qs_scan_string "$obj" "$i" || return 0
                key="$__LLM_REPLY"
                i="$__LLM_JSON_END"
                i="$(_qs_skip_ws "$obj" "$i")"
                [[ "${obj:$i:1}" == ":" ]] || continue
                i="$(_qs_skip_ws "$obj" $((i + 1)))"
                case "${obj:$i:1}" in
                    '"')
                        _qs_scan_string "$obj" "$i" || return 0
                        printf '%s=%s\n' "$key" "$__LLM_REPLY"
                        i="$__LLM_JSON_END"
                        ;;
                    '{'|'[')
                        # Skip the whole nested structure.
                        depth=0
                        while [[ $i -lt $n ]]; do
                            case "${obj:$i:1}" in
                                '{'|'[') depth=$((depth + 1)) ;;
                                '}'|']') depth=$((depth - 1)) ;;
                                '"') _qs_scan_string "$obj" "$i" && i=$((__LLM_JSON_END - 1)) ;;
                            esac
                            i=$((i + 1))
                            [[ $depth -eq 0 ]] && break
                        done
                        ;;
                    *)
                        # Scalar (number/bool/null): skip to the next delimiter.
                        while [[ $i -lt $n ]]; do
                            case "${obj:$i:1}" in
                                ','|'}'|']') break ;;
                            esac
                            i=$((i + 1))
                        done
                        ;;
                esac
                ;;
            *) i=$((i + 1)) ;;
        esac
    done
}

# Extract array of strings (e.g. protocols).
# Echoes one string per line.
_qs_extract_string_array() {
    local body="$1"
    printf '%s' "$body" \
        | tr -d '\n' \
        | grep -oE '"[^"]*"' \
        | sed -E 's/^"//; s/"$//'
}

# Validate that a model id is safe to use as an INI section name.
# Allowed: alphanumerics, dot, dash, underscore.
_qs_id_is_safe() {
    _llm_id_is_safe "$1"
}

# Validators for the remaining scraped fields.
#
# _qs_process_v2_file previously validated only vendor_short, api_key_var and
# the model id. upstream_id, description, endpoints and signup_url went
# straight into the user's config via _qs_emit_provider. The store no longer
# evals values, so these can no longer execute -- but an unvalidated string can
# still forge a config section (via a newline), point a provider at a
# non-HTTP URL, or produce a value the INI parser silently mangles.

# A URL that is safe to record as base_url or signup_url.
_qs_url_is_safe() {
    local u="$1"
    [[ -n "$u" ]] || return 1
    # http(s) only: file://, data:// etc have no business in a provider config.
    case "$u" in
        http://*|https://*) ;;
        *) return 1 ;;
    esac
    # A newline or CR would let one value forge additional config lines.
    case "$u" in
        *$'\n'*|*$'\r'*) return 1 ;;
    esac
    # Quotes and backslashes confuse INI readers and shell display alike, and
    # have no legitimate place in a provider URL.
    case "$u" in
        *[\'\"\\]*) return 1 ;;
    esac
    return 0
}

# A model identifier sent to a provider. Broader than _llm_id_is_safe because
# upstream ids legitimately contain ':' and '/' (e.g. hf:moonshotai/Kimi-K2.5).
_qs_model_id_is_safe() {
    local m="$1"
    [[ -n "$m" ]] || return 1
    case "$m" in
        *[!A-Za-z0-9._:/-]*) return 1 ;;
    esac
    return 0
}

# Free text written as a description/comment. Must stay on one line so it
# cannot forge a [section] header or a key=value pair.
_qs_text_is_safe() {
    case "$1" in
        *$'\n'*|*$'\r'*) return 1 ;;
    esac
    return 0
}

# Process a single quickstart v2 JSON file. Appends provider and group
# sections to the user config. Echoes informational messages to stdout.
# On schema/validation error, returns 1 and emits an error message.
#
# Args:
#   $1 = path to JSON file
#   $2 = path to user config file
# Updates the global array `_qs_added_names` with names of added sections.
_qs_added_names=()
_qs_process_v2_file() {
    local json_file="$1" user_config="$2"
    local json
    json="$(cat "$json_file")"
    if [[ -z "$json" ]]; then
        echo "❌ Quickstart file is empty: $json_file" >&2
        return 1
    fi

    local schema_version
    schema_version="$(_qs_json_string "$json" "schema_version")"
    if [[ "$schema_version" != "2" ]]; then
        if [[ -z "$schema_version" ]]; then
            echo "❌ Quickstart file is missing schema_version (or has malformed JSON): $json_file" >&2
            echo "   This file may be in legacy v1 format. Re-run install.sh to fetch v2 files." >&2
        else
            echo "❌ Unsupported schema_version '$schema_version' in $json_file (expected '2')." >&2
        fi
        return 1
    fi

    local vendor_short api_key_var signup_url endpoints_obj
    vendor_short="$(_qs_json_string "$json" "vendor_short")"
    api_key_var="$(_qs_json_string "$json" "api_key_var")"
    signup_url="$(_qs_json_string "$json" "signup_url")"
    endpoints_obj="$(_qs_json_object "$json" "endpoints")"

    if [[ -z "$vendor_short" || -z "$api_key_var" || -z "$endpoints_obj" ]]; then
        echo "❌ Quickstart file missing required top-level fields (vendor_short, api_key_var, endpoints): $json_file" >&2
        return 1
    fi
    if ! _qs_id_is_safe "$vendor_short"; then
        echo "❌ Quickstart file vendor_short '$vendor_short' contains characters unsafe for config sections: $json_file" >&2
        return 1
    fi
    if ! _qs_id_is_safe "$api_key_var"; then
        echo "❌ Quickstart file api_key_var '$api_key_var' contains characters unsafe for config: $json_file" >&2
        return 1
    fi

    local endpoint_openai endpoint_anthropic
    endpoint_openai="$(_qs_json_string "$endpoints_obj" "openai")"
    endpoint_anthropic="$(_qs_json_string "$endpoints_obj" "anthropic")"

    # Validate the scraped URLs before any of them can reach the config.
    # These come from a daily scrape that is auto-merged without review.
    if [[ -n "$endpoint_openai" ]] && ! _qs_url_is_safe "$endpoint_openai"; then
        echo "❌ Quickstart file has an unsafe openai endpoint: $json_file" >&2
        return 1
    fi
    if [[ -n "$endpoint_anthropic" ]] && ! _qs_url_is_safe "$endpoint_anthropic"; then
        echo "❌ Quickstart file has an unsafe anthropic endpoint: $json_file" >&2
        return 1
    fi
    if [[ -n "$signup_url" ]] && ! _qs_url_is_safe "$signup_url"; then
        echo "  ⚠️  Ignoring unsafe signup_url in $json_file" >&2
        signup_url=""
    fi

    local models_body family_latest_obj
    models_body="$(_qs_json_array_body "$json" "models")"
    family_latest_obj="$(_qs_json_object "$json" "family_latest")"

    # Map model id -> "openai,anthropic" of available protocols, used to
    # decide whether family_latest entries get groups vs single-member aliases.
    local -a model_ids=()
    local -a model_protocols=()  # parallel array, "openai,anthropic" form

    # Parse models[] block by block. Objects are NUL-delimited to survive
    # multi-line content.
    local model_obj id family version description upstream_id protocols_body
    # Loop-scoped variables are declared ONCE here, never inside the loops
    # below: zsh prints "name=<previous value>" when `local` re-declares an
    # existing local, which corrupts stdout mid-run (and leaked $proto).
    local proto have_openai have_anthropic proto_csv default_model pname
    local pair fam fam_id idx j providers_csv __n __base
    while IFS= read -r -d '' model_obj; do
        [[ -z "$model_obj" ]] && continue
        id="$(_qs_json_string "$model_obj" "id")"
        family="$(_qs_json_string "$model_obj" "family")"
        version="$(_qs_json_string "$model_obj" "version")"
        description="$(_qs_json_string "$model_obj" "description")"
        upstream_id="$(_qs_json_string "$model_obj" "upstream_id")"
        protocols_body="$(_qs_json_array_body "$model_obj" "protocols")"

        if [[ -z "$id" ]]; then
            echo "  ⚠️  Skipping model with no id" >&2
            continue
        fi
        if [[ -n "$upstream_id" ]] && ! _qs_model_id_is_safe "$upstream_id"; then
            echo "  ⚠️  Skipping model '$id' - upstream_id contains unsafe characters" >&2
            continue
        fi
        if ! _qs_text_is_safe "$description"; then
            echo "  ⚠️  Model '$id' - dropping multi-line description" >&2
            description=""
        fi
        if ! _qs_id_is_safe "$id"; then
            echo "  ⚠️  Skipping model '$id' - id contains characters unsafe for config sections" >&2
            continue
        fi

        # Compute available protocols intersecting model.protocols with what
        # the file's endpoints declare.
        have_openai=false; have_anthropic=false
        while IFS= read -r proto; do
            [[ -z "$proto" ]] && continue
            case "$proto" in
                openai)    [[ -n "$endpoint_openai" ]]    && have_openai=true ;;
                anthropic) [[ -n "$endpoint_anthropic" ]] && have_anthropic=true ;;
            esac
        done < <(_qs_extract_string_array "$protocols_body")

        # Track for family_latest emission.
        proto_csv=""
        [[ "$have_openai"    == true ]] && proto_csv="openai"
        if [[ "$have_anthropic" == true ]]; then
            [[ -n "$proto_csv" ]] && proto_csv+=","
            proto_csv+="anthropic"
        fi
        model_ids+=("$id")
        model_protocols+=("$proto_csv")

        default_model="${upstream_id:-$id}"

        if [[ "$have_openai" == true ]]; then
            pname="openai_${vendor_short}_${id}"
            _qs_emit_provider "$user_config" "$pname" "$endpoint_openai" \
                "$api_key_var" "$default_model" "$description" "openai" "$signup_url"
        fi
        if [[ "$have_anthropic" == true ]]; then
            pname="anth_${vendor_short}_${id}"
            _qs_emit_provider "$user_config" "$pname" "$endpoint_anthropic" \
                "$api_key_var" "$default_model" "$description" "anthropic" "$signup_url"
        fi

        # A model that matched no endpoint produces nothing. Say so: it was
        # previously dropped in complete silence, unlike every other skip path
        # in this loop, so a scraper change that removed an endpoint or a
        # protocols array looked like a successful run.
        if [[ "$have_openai" != true && "$have_anthropic" != true ]]; then
            echo "  ⚠️  Skipping model '$id' - no protocol matches this file's endpoints" >&2
        fi

        # Per-model group only when both protocols available.
        if [[ "$have_openai" == true && "$have_anthropic" == true ]]; then
            _qs_emit_group "$user_config" \
                "${vendor_short}_${id}" \
                "openai_${vendor_short}_${id},anth_${vendor_short}_${id}"
        fi
    done < <(_qs_split_object_array "$models_body")

    # Family-latest groups.
    if [[ -n "$family_latest_obj" ]]; then
        while IFS= read -r pair; do
            [[ -z "$pair" ]] && continue
            fam="${pair%%=*}"
            fam_id="${pair#*=}"
            if ! _qs_id_is_safe "$fam"; then
                echo "  ⚠️  Skipping family_latest entry '$fam' - unsafe family name" >&2
                continue
            fi
            if ! _qs_id_is_safe "$fam_id"; then
                continue
            fi
            # Look up protocols for this model id from the parallel arrays.
            idx=-1
            # ${!arr[@]} is a bash-only index expansion ("bad substitution" in
            # zsh). Walk by count instead, which is portable. Note zsh arrays
            # are 1-indexed, hence __base.
            __n=${#model_ids[@]}
            if [[ "${CURRENT_SHELL}" == "zsh" ]]; then __base=1; else __base=0; fi
            j=$__base
            while [[ $j -lt $((__n + __base)) ]]; do
                if [[ "${model_ids[$j]}" == "$fam_id" ]]; then
                    idx="$j"; break
                fi
                j=$((j + 1))
            done
            if [[ "$idx" -lt 0 ]]; then
                echo "  ⚠️  family_latest references unknown model id '$fam_id'" >&2
                continue
            fi
            providers_csv=""
            case "${model_protocols[$idx]}" in
                "openai,anthropic")
                    providers_csv="openai_${vendor_short}_${fam_id},anth_${vendor_short}_${fam_id}" ;;
                "openai")
                    providers_csv="openai_${vendor_short}_${fam_id}" ;;
                "anthropic")
                    providers_csv="anth_${vendor_short}_${fam_id}" ;;
            esac
            [[ -z "$providers_csv" ]] && continue
            _qs_emit_group "$user_config" "${vendor_short}_${fam}" "$providers_csv"
        done < <(_qs_extract_string_pairs "$family_latest_obj")
    fi

    return 0
}

# Append a provider section to the user config if not already present.
_qs_emit_provider() {
    local user_config="$1" name="$2" base_url="$3" api_key_var="$4"
    local default_model="$5" description="$6" protocol="$7" signup_url="$8"

    # -F -x: literal, whole-line. The name used to be interpolated into a basic
    # regex, so the '.' in an id like glm-5.2 matched any character and
    # [openai_synth_glm-5X2] counted as already present.
    if grep -qFx "[$name]" "$user_config" 2>/dev/null; then
        echo "  ⚠️  Skipping provider '$name' - already exists in config"
        return 0
    fi
    echo "  ➕ Adding provider: $name"
    {
        echo ""
        [[ -n "$description" ]] && echo "# $description"
        echo "[$name]"
        echo "base_url=$base_url"
        echo "api_key_var=$api_key_var"
        echo "default_model=$default_model"
        if [[ -n "$protocol" && "$protocol" != "openai" ]]; then
            echo "protocol=$protocol"
        fi
        [[ -n "$description" ]] && echo "description=$description"
        echo "enabled=true"
        if [[ -n "$signup_url" ]]; then
            echo "signup_url=$signup_url"
        fi
        echo ""
    } >> "$user_config"
    _qs_added_names+=("$name")
}

# Append a [group:NAME] section to the user config if not already present.
_qs_emit_group() {
    local user_config="$1" group_name="$2" providers_csv="$3"
    if grep -qFx "[group:$group_name]" "$user_config" 2>/dev/null; then
        echo "  ⚠️  Skipping group '$group_name' - already exists in config"
        return 0
    fi
    echo "  ➕ Adding group: $group_name"
    {
        echo ""
        echo "[group:$group_name]"
        echo "providers=$providers_csv"
        echo ""
    } >> "$user_config"
    _qs_added_names+=("group:$group_name")
}

# Resolve the user's selection of catalog sources for cmd_quickstart.
# Inputs:
#   $1 = positional argument from CLI (may be empty, "all", "synthetic",
#        "alibaba", or a comma-separated list).
#   $2 = comma-separated list of *available* sources (those whose JSON
#        files were found, in order: synthetic,alibaba).
# Output (echoed): a comma-separated subset of the available sources.
# Return code: 0 on valid selection, non-zero on invalid input. Caller
# uses the return code to decide whether to abort.
_qs_resolve_selection() {
    local arg="${1:-}"
    local available="${2:-}"

    # Normalize: trim whitespace around commas, lowercase.
    arg="$(printf '%s' "$arg" | tr '[:upper:]' '[:lower:]' | sed 's/[[:space:]]*,[[:space:]]*/,/g; s/^[[:space:]]*//; s/[[:space:]]*$//')"

    # Empty arg → caller decides (interactive prompt or "all" fallback).
    if [[ -z "$arg" ]]; then
        printf '%s' "$available"
        return 0
    fi

    if [[ "$arg" == "all" ]]; then
        printf '%s' "$available"
        return 0
    fi

    # Validate every comma-separated token is a known source AND is
    # currently available. Build the result preserving caller's order.
    local IFS=','
    local -a tokens
    # zsh's `read` has no -a (it spells it -A), so this aborted the whole
    # sourced file with "bad option: -a". __llm_split works in both shells.
    # __llm_split deliberately forces IFS=' ' so a caller's strict-mode IFS
    # cannot defeat it, which means comma inputs must be converted first.
    __llm_split "${arg//,/ }"
    local -a tokens
    tokens=(${__LLM_WORDS[@]+"${__LLM_WORDS[@]}"})
    local out=""
    local tok
    for tok in ${tokens[@]+"${tokens[@]}"}; do
        if [[ "$tok" != "synthetic" && "$tok" != "alibaba" ]]; then
            echo "❌ Unknown quickstart source: '$tok'. Valid: synthetic, alibaba, all (or comma-separated combinations)." >&2
            return 1
        fi
        # Must be in available list.
        if [[ ",$available," != *",$tok,"* ]]; then
            echo "❌ Quickstart source '$tok' selected but its JSON file is not available." >&2
            return 1
        fi
        if [[ -n "$out" ]]; then
            out+=","
        fi
        out+="$tok"
    done
    printf '%s' "$out"
    return 0
}

# Returns true when stdin is a TTY (interactive shell). Centralized so
# tests can stub it via function override.
_qs_is_interactive() {
    [[ -t 0 ]]
}

# Detect the user's shell rc file. Echoes the path, or empty for shells
# we don't auto-write to. Mirrors install.sh:307–315.
#
# bash → ~/.bashrc, falling back to ~/.bash_profile if .bashrc is
# missing AND .bash_profile exists. ~/.bashrc otherwise (created on
# write).
# zsh → ~/.zshrc.
# fish/csh/tcsh/other → empty (caller prints the export line manually).
# Retained as the name quickstart and its tests already call. The logic lives
# in detect_shell_rc so llm-env and install.sh cannot drift apart -- they
# previously carried the same rules copy-pasted, including the same bug.
_qs_detect_shell_rc() {
    detect_shell_rc
}

# True (return 0) when the named env var is already set in the current
# environment, OR when the rc file contains an `export VAR=...` line
# (any leading whitespace, any quoting).
#
# Args: $1 = var name, $2 = rc file path (may be empty).
_qs_key_already_set() {
    local var="$1" rc_file="$2"
    [[ -z "$var" ]] && return 1
    # Env check.
    # ${!var} is bash-only indirect expansion ("bad substitution" in zsh).
    get_var_value "$var"
    if [[ -n "$__LLM_REPLY" ]]; then
        return 0
    fi
    # rc-file check.
    if [[ -n "$rc_file" && -f "$rc_file" ]]; then
        if grep -qE "^[[:space:]]*export[[:space:]]+${var}=" "$rc_file"; then
            return 0
        fi
    fi
    return 1
}

# Prompt for an API key, masked. Treats empty input, 's', or
# whitespace-only as skip. On a real key, echoes the (trimmed) key on
# stdout and returns 0. On skip, returns 1.
#
# Args: $1 = var name (only used in the prompt label).
_qs_prompt_api_key() {
    local var="$1"
    local key=""
    # -s: don't echo input. -r: don't process backslashes. -p prompt
    # writes to stderr to keep stdout clean for the caller.
    printf '   Paste your %s (input hidden, blank or '\''s'\'' to skip): ' "$var" >&2
    IFS= read -r -s key
    printf '\n' >&2
    # Trim whitespace.
    local trimmed
    trimmed="$(printf '%s' "$key" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    if [[ -z "$trimmed" || "$trimmed" == "s" || "$trimmed" == "S" ]]; then
        return 1
    fi
    printf '%s' "$trimmed"
    return 0
}

# Append `export VAR='value'` to the given rc file. Idempotent: if a
# matching `export VAR=` line already exists, leaves the file alone
# and returns 1 (caller knows nothing was written).
#
# Args: $1 = var, $2 = value, $3 = rc file path (must be non-empty).
# Single-quote escaping uses the standard close-escape-reopen pattern
# so values containing apostrophes round-trip correctly.
_qs_append_export_to_rc() {
    local var="$1" value="$2" rc_file="$3"
    if [[ -z "$rc_file" ]]; then
        return 1
    fi

    # Don't duplicate. Recognise the other common spellings too: the old
    # anchored `export VAR=` pattern missed `VAR=x; export VAR` and
    # `export  VAR =`, so a second run appended a duplicate export.
    if [[ -f "$rc_file" ]] && grep -qE "(^|;)[[:space:]]*(export[[:space:]]+)?${var}[[:space:]]*=" "$rc_file"; then
        return 1
    fi

    # Create with a restrictive umask: this file is about to hold an API key,
    # and it was previously created world-readable under the ambient umask.
    if [[ ! -f "$rc_file" ]]; then
        local old_umask
        old_umask="$(umask)"
        umask 077
        : > "$rc_file" || { umask "$old_umask"; return 1; }
        umask "$old_umask"
    elif [[ -s "$rc_file" ]]; then
        # Append a newline only if the file does not already end with one.
        #
        # The previous check was `[[ "$(tail -c 1 ...)" != $'\n' ]]`, but
        # command substitution strips trailing newlines, so the comparison was
        # ALWAYS true and a blank line accumulated on every run.
        if [[ "$(tail -c 1 "$rc_file" | wc -l | tr -d ' ')" == "0" ]]; then
            printf '\n' >> "$rc_file" || return 1
        fi
    fi

    # Warn, but do NOT silently re-chmod a pre-existing rc file. Changing
    # permissions the user chose is surprising, and doing it before the append
    # would also make a deliberately-unwritable file writable, defeating the
    # graceful-failure path below. Files we create ourselves are already 600
    # via the umask above.
    if [[ -r "$rc_file" ]]; then
        local mode
        # The path is a known rc file we just resolved, not arbitrary input.
        # shellcheck disable=SC2012
        mode="$(ls -l "$rc_file" 2>/dev/null | cut -c5-10)"
        case "$mode" in
            *[rwx]*)
                echo "   ⚠️  $rc_file is readable by others; it will contain an API key." >&2
                echo "      Consider: chmod 600 $rc_file" >&2
                ;;
        esac
    fi

    # Single-quote-escape the value: every ' becomes '"'"'.
    local escaped="${value//\'/\'\"\'\"\'}"
    printf "export %s='%s'\n" "$var" "$escaped" >> "$rc_file" || return 1

    # On Git Bash, mintty starts `bash --login -i`, which reads a login file
    # and never ~/.bashrc. If we just created the login file and a ~/.bashrc
    # already exists, chain-load it so the user's existing setup still runs.
    if [[ "${__LLM_RC_NEEDS_CHAIN:-0}" == "1" && -f "$HOME/.bashrc" ]]; then
        if ! grep -q '\.bashrc' "$rc_file" 2>/dev/null; then
            printf '\n# Load ~/.bashrc for interactive login shells (added by llm-env)\n' >> "$rc_file"
            printf '[ -f ~/.bashrc ] && . ~/.bashrc\n' >> "$rc_file"
        fi
    fi
    return 0
}

# Run cmd_test against a provider, capture its output, and print a
# single-line ✅/❌ summary. Always returns 0 — verification is
# informational and must not abort quickstart.
#
# Args: $1 = provider name to test.
_qs_verify_key() {
    local provider="$1"
    local out rc
    out="$(cmd_test "$provider" 2>&1)"
    rc=$?
    if [[ $rc -eq 0 ]]; then
        echo "   ✅ Verified: $provider"
    else
        # Print warning but never propagate failure to caller.
        echo "   ⚠️  Warning: verification of $provider failed (exit $rc). Set the key manually if needed."
        # Also surface the last line of the cmd_test output for context.
        local tail_line
        tail_line="$(printf '%s' "$out" | tail -n 1)"
        [[ -n "$tail_line" ]] && echo "      $tail_line"
    fi
    return 0
}

cmd_quickstart() {
    echo "🚀 Quickstart - Adding provider definitions from quickstart JSON files"
    echo

    # Declare every loop-scoped local ONCE, here, before any loop runs.
    #
    # zsh prints "name=<previous value>" when `local name` re-declares an
    # existing local, so declaring these inside the per-source loop leaked
    # their contents to the terminal on the second and later iterations. For
    # $key that value came from `read -s` -- the API key, in cleartext.
    local src="" json_file="" api_key_var="" signup_url="" verify_provider=""
    local key="" rc_file=""

    # Locate quickstart JSON files. LLM_ENV_QUICKSTART_DIR overrides the
    # script directory (used by tests and advanced setups).
    local quickstart_dir="${LLM_ENV_QUICKSTART_DIR:-$(get_script_dir)}"
    local synthetic_json="$quickstart_dir/quickstart-synthetic.json"
    local alibaba_json="$quickstart_dir/quickstart-alibaba.json"

    # Track which sources are available (in deterministic order).
    local available=""
    [[ -f "$synthetic_json" ]] && available="${available:+$available,}synthetic"
    [[ -f "$alibaba_json" ]] && available="${available:+$available,}alibaba"

    if [[ -z "$available" ]]; then
        echo "❌ No quickstart JSON files found in: $quickstart_dir" >&2
        echo "💡 Expected: quickstart-synthetic.json and/or quickstart-alibaba.json" >&2
        return 1
    fi

    # Resolve which sources to process. Empty arg + non-TTY → all available.
    # Empty arg + TTY → currently still all (interactive prompt arrives in
    # Phase 2 of the interactive-quickstart feature).
    local selection
    if ! selection="$(_qs_resolve_selection "${1:-}" "$available")"; then
        return 1
    fi

    if [[ -z "$selection" ]]; then
        echo "ℹ️  No sources selected — exiting."
        return 0
    fi

    local user_config
    user_config="$(get_user_config_path)"
    mkdir -p "$(dirname "$user_config")"
    if [[ ! -f "$user_config" ]]; then
        echo "📝 Creating user configuration file: $user_config"
        touch "$user_config"
    else
        echo "📝 Using existing user configuration: $user_config"
    fi

    # Detect shell rc once up-front (empty for unsupported shells).
    # rc_file is declared at the top of the function; re-declaring it here
    # would make zsh print its current value.
    rc_file="$(_qs_detect_shell_rc)"

    _qs_added_names=()
    local rc=0
    local interactive=false
    if _qs_is_interactive; then
        interactive=true
    fi

    # (src is declared at the top of the function; re-declaring it here made
    # zsh print "src=''" to stdout.)
    local IFS_old="$IFS"
    IFS=','
    # zsh does not word-split an unquoted expansion, so this iterated ONCE
    # with the whole "synthetic,alibaba" string, matched no case arm, and left
    # json_file empty -- the visible symptom was "Quickstart file is empty:".
    __llm_split "${selection//,/ }"
    for src in ${__LLM_WORDS[@]+"${__LLM_WORDS[@]}"}; do
        IFS="$IFS_old"
        # (json_file/api_key_var/signup_url/verify_provider are declared once
        # at the top of the function -- see the note there about zsh printing
        # a re-declared local.)
        json_file=""; api_key_var=""; signup_url=""; verify_provider=""
        case "$src" in
            synthetic)
                json_file="$synthetic_json"
                api_key_var="LLM_SYNTHETIC_API_KEY"
                signup_url="https://synthetic.new/?referral=ugceNlJ08A3Eeww"
                # verify_provider is derived after emission -- see below. It
                # used to hardcode anth_synth_kimi-k2.5, which the scraper
                # renamed to kimi-k2.7-code and auto-merged, leaving the id
                # pointing at a provider that no longer exists.
                ;;
            alibaba)
                json_file="$alibaba_json"
                api_key_var="LLM_ALIBABA_API_KEY"
                signup_url="https://www.alibabacloud.com/campaign/benefits?referral_code=A92LUX"
                ;;
        esac

        echo "🔍 Processing: $json_file"
        local __before=${#_qs_added_names[@]}
        if ! _qs_process_v2_file "$json_file" "$user_config"; then
            rc=1
            IFS=','
            continue
        fi
        # Derive the verification target from the sections just emitted, so it
        # can never drift from the catalog. Prefer an anthropic provider (the
        # protocol quickstart is primarily used to configure) and fall back to
        # whatever was added first.
        local __k __n2=${#_qs_added_names[@]} __i2=$__before
        while [[ $__i2 -lt $__n2 ]]; do
            __k="${_qs_added_names[$__i2]}"
            case "$__k" in
                anth_*)   verify_provider="$__k"; break ;;
                openai_*) [[ -z "$verify_provider" ]] && verify_provider="$__k" ;;
            esac
            __i2=$((__i2 + 1))
        done
        echo

        if [[ "$interactive" == true ]]; then
            if _qs_key_already_set "$api_key_var" "$rc_file"; then
                echo "✅ $api_key_var is already configured — skipping prompt."
                echo
            else
                echo "🔑 Sign up for $src to get your API key:"
                printf '   %s\n' "$(link "$signup_url" "$signup_url")"
                echo
                printf '   Press Enter once you have your key (or '\''s'\'' + Enter to skip): '
                read -r _   # discard; just a pause
                # NOTE: `key` is declared once at the top of this function,
                # not here. Re-declaring an existing local inside a loop makes
                # zsh PRINT "key=<previous value>" -- and the previous value
                # came from _qs_prompt_api_key's `read -s`, so the API key was
                # echoed to the terminal in cleartext from the second source
                # onward.
                if key="$(_qs_prompt_api_key "$api_key_var")"; then
                    if [[ -n "$rc_file" ]]; then
                        if _qs_append_export_to_rc "$api_key_var" "$key" "$rc_file"; then
                            echo "   ✓ Appended $api_key_var to $rc_file"
                        else
                            # rc_file write failed or duplicate — print fallback.
                            echo "   ⚠️  Could not write to $rc_file. Add this line manually:"
                            echo "      export $api_key_var='<your key>'"
                        fi
                    else
                        echo "   ℹ️  Your shell isn't auto-supported. Add this to your shell config:"
                        echo "      export $api_key_var='<your key>'"
                    fi
                    # Make the key visible to cmd_test in this session for verification.
                    export "$api_key_var=$key"
                    _qs_verify_key "$verify_provider"
                else
                    echo "   ⏭️  Skipped — set $api_key_var manually when you're ready."
                fi
                echo
            fi
        fi
        IFS=','
    done
    IFS="$IFS_old"

    # Re-read the config so the sections just written are visible to this
    # shell. Without this the in-memory provider set was whatever existed at
    # source time, so _qs_verify_key always reported the brand-new key as
    # failing and `list` did not show the new providers until the next command.
    if [[ ${#_qs_added_names[@]} -gt 0 ]]; then
        init_config >/dev/null 2>&1 || true
    fi

    if [[ ${#_qs_added_names[@]} -gt 0 ]]; then
        echo "🎉 Added ${#_qs_added_names[@]} new entr$([[ ${#_qs_added_names[@]} -eq 1 ]] && echo y || echo ies) to your configuration."
    else
        echo "ℹ️  No new providers or groups were added (they may already exist)."
    fi

    if [[ "$interactive" != true ]]; then
        # Non-interactive path: print signup links footer for the user
        # to follow up on manually.
        echo
        echo "🔗 Sign up for API access:"
        printf '   Synthetic: %s\n' "$(link "https://synthetic.new/?referral=ugceNlJ08A3Eeww" "https://synthetic.new")"
        printf '   Alibaba Cloud Coding Plan: %s\n' "$(link "https://www.alibabacloud.com/campaign/benefits?referral_code=A92LUX" "https://alibabacloud.com/campaign/benefits")"
    fi

    echo
    echo "💡 Next steps:"
    echo "   llm-env list                       # see what's available"
    # Name a provider that was actually emitted. A hardcoded example id goes
    # stale silently the next time the daily scraper renames a model.
    if [[ -n "$verify_provider" ]]; then
        echo "   llm-env set $verify_provider   # activate a provider"
    else
        echo "   llm-env set <provider>             # activate a provider"
    fi
    if [[ "$interactive" == true && -n "$rc_file" ]]; then
        echo "   source $rc_file                    # reload shell so new keys are active"
    fi
    echo

    return $rc
}

