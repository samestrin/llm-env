#!/usr/bin/env bash
# llm-env - LLM Environment Manager
# Usage:
#   source ./llm-env set <provider>
#   source ./llm-env unset
#   source ./llm-env list
#   source ./llm-env show
#   source ./llm-env config <command>

# Version information
LLM_ENV_VERSION="1.7.0"

# llm-env is sourced into the user's shell. A user who has `set -u` (nounset)
# in their profile would otherwise abort on this script's own unset-variable
# reads -- notably empty-array expansions, which raise "unbound variable" on
# bash < 4.4 (the macOS system bash 3.2). Disable nounset for the duration of
# this script's own execution and restore the caller's setting at the end
# (see the Entry Point at the bottom of this file).
case $- in *u*) __LLM_ENV_RESTORE_NOUNSET=1 ;; *) __LLM_ENV_RESTORE_NOUNSET=0 ;; esac
set +u

# ---------- Shell Detection and Version ----------

# Detect which shell we're running in
detect_shell() {
    if [[ -n "${ZSH_VERSION:-}" ]]; then
        CURRENT_SHELL="zsh"
        SHELL_VERSION="${ZSH_VERSION}"
        # Deliberately NOT `setopt BASH_REMATCH`.
        #
        # llm-env is sourced into the user's interactive shell, and setopt
        # without `localoptions` is permanent for that session. Enabling
        # BASH_REMATCH changes how every later regex match populates $match and
        # $MATCH -- they stop being set at all -- silently breaking any zsh
        # plugin, prompt, or completion that reads them. `localoptions` is not
        # an alternative here: it would restore the option on return from
        # detect_shell, long before the matches that need it.
        #
        # get_match reads zsh's native $match array instead, which also removes
        # the fragile index offset the option required (captures landed at
        # [2]/[3] under BASH_REMATCH but [1]/[2] without it).
        :
    elif [[ -n "${BASH_VERSION:-}" ]]; then
        CURRENT_SHELL="bash"
        SHELL_VERSION="${BASH_VERSION}"
    else
        CURRENT_SHELL="unknown"
        SHELL_VERSION="0.0"
    fi
    export CURRENT_SHELL SHELL_VERSION
}

# Get a regex capture group. Sets the global __LLM_REPLY (no stdout, no fork).
# Usage: get_match 1; result=$__LLM_REPLY   # first capture group
# Call immediately after the matching [[ =~ ]] while the captures are current.
#
# bash exposes captures in BASH_REMATCH, 0-indexed with the whole match at [0].
# zsh exposes them in its native $match array, 1-indexed with capture 1 at [1].
# Reading $match directly means the script no longer has to enable -- and
# permanently leak into the user's session -- the BASH_REMATCH option purely to
# borrow bash's names. See detect_shell.
#
# The shell test is at call time rather than source time because
# parse_bash_version calls this while establishing CURRENT_SHELL itself.
get_match() {
    if [[ "${CURRENT_SHELL:-}" == "zsh" ]]; then
        # shellcheck disable=SC2154  # $match is a zsh builtin array
        eval '__LLM_REPLY="${match[$1]-}"'
    else
        __LLM_REPLY="${BASH_REMATCH[$1]-}"
    fi
}

# Parse shell version for compatibility features
parse_bash_version() {
    local version major minor

    # Detect shell first
    detect_shell

    # Zsh has native associative array support
    if [[ "${CURRENT_SHELL}" == "zsh" ]]; then
        # Zsh has full associative array support
        BASH_ASSOC_ARRAY_SUPPORT=true
        BASH_DECLARE_GLOBAL_SUPPORT=true
        # Parse zsh version
        version="${ZSH_VERSION:-5.0}"
        if [[ "${version}" =~ ^([0-9]+)\.([0-9]+) ]]; then
            # Read captures via get_match, which uses zsh's native $match. The
            # old [2]/[3] indices only held while the BASH_REMATCH option was
            # enabled -- an offset that silently inverted when it was not.
            get_match 1; major="$__LLM_REPLY"
            get_match 2; minor="$__LLM_REPLY"
        else
            major=5
            minor=0
        fi
        export BASH_MAJOR_VERSION=${major}
        export BASH_MINOR_VERSION=${minor}
        export BASH_ASSOC_ARRAY_SUPPORT
        export BASH_DECLARE_GLOBAL_SUPPORT
        debug "Zsh version: ${major}.${minor}, associative array support: ${BASH_ASSOC_ARRAY_SUPPORT}"
        return
    fi

    # Bash version detection
    version="${BASH_VERSION:-4.0.0}"

    # Extract major and minor version numbers
    if [[ "${version}" =~ ^([0-9]+)\.([0-9]+) ]]; then
        major="${BASH_REMATCH[1]}"
        minor="${BASH_REMATCH[2]}"
    else
        # Fallback to conservative defaults if parsing fails
        major=3
        minor=2
    fi

    # Set global compatibility flags
    if [[ ${major} -gt 4 || (${major} -eq 4 && ${minor} -ge 0) ]]; then
        BASH_ASSOC_ARRAY_SUPPORT=true
    else
        BASH_ASSOC_ARRAY_SUPPORT=false
    fi

    # Check for declare -g support (Bash 4.2+)
    if [[ ${major} -gt 4 || (${major} -eq 4 && ${minor} -ge 2) ]]; then
        BASH_DECLARE_GLOBAL_SUPPORT=true
    else
        BASH_DECLARE_GLOBAL_SUPPORT=false
    fi

    export BASH_MAJOR_VERSION=${major}
    export BASH_MINOR_VERSION=${minor}
    export BASH_ASSOC_ARRAY_SUPPORT
    export BASH_DECLARE_GLOBAL_SUPPORT

    debug "Bash version: ${major}.${minor}, associative array support: ${BASH_ASSOC_ARRAY_SUPPORT}, declare -g support: ${BASH_DECLARE_GLOBAL_SUPPORT}"
}

# Debug function (needed early for version detection)
debug() {
    if [[ "${LLM_ENV_DEBUG:-0}" == "1" ]]; then
        echo "[DEBUG] $*" >&2
    fi
}

# Get script directory with bash 3.2 and zsh compatibility
get_script_dir() {
    local script_dir

    if [[ "${CURRENT_SHELL}" == "zsh" ]]; then
        # In zsh, use funcsourcetrace or fallback to command -v
        if [[ -n "${funcsourcetrace[1]:-}" ]]; then
            script_dir="$(dirname "${funcsourcetrace[1]%:*}")"
        else
            script_dir="$(dirname "$(command -v llm-env 2>/dev/null || echo ".")")"
        fi
    elif [[ -n "${BASH_SOURCE[0]:-}" ]]; then
        script_dir="$(dirname "${BASH_SOURCE[0]}")"
    else
        # Fallback: assume script is in current directory or PATH
        script_dir="$(dirname "$(command -v llm-env 2>/dev/null || echo ".")")"
    fi
    echo "$script_dir"
}

# Initialize bash version detection
parse_bash_version

# (get_match is defined above, before parse_bash_version needs it.)

# Helper function for indirect variable expansion (works in both bash and zsh)
# Sets the global __LLM_REPLY to the named variable's value (empty if unset).
# Usage: get_var_value "SOME_VAR_NAME"; result=$__LLM_REPLY
get_var_value() {
    local var_name="$1"
    if [[ "${CURRENT_SHELL}" == "zsh" ]]; then
        # shellcheck disable=SC2296 # zsh-specific indirect expansion syntax
        __LLM_REPLY="${(P)var_name-}"
    else
        __LLM_REPLY="${!var_name-}"
    fi
}

# Trim leading/trailing whitespace using parameter expansion (no subshell fork).
# Sets the global __LLM_REPLY. Works in both bash and zsh. Usage: trim "$s"; s=$__LLM_REPLY
trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"   # strip leading whitespace
    s="${s%"${s##*[![:space:]]}"}"   # strip trailing whitespace
    __LLM_REPLY="$s"
}

# Configuration state variables
CONFIG_SOURCE=""  # none, user, system, builtin
CONFIG_LOADED=false

# ---------- Provider store ----------
#
# Provider data lives in flat scalar variables, not associative arrays:
#
#   __LLM_V_<MAP>__<mangled_key>   the value (set == the key exists)
#   __LLM_KN_<MAP>                 number of registered keys
#   __LLM_K_<MAP>__<i>             i-th key, in insertion order
#
# This replaced two divergent backends -- native `declare -A` on bash 4+/zsh
# and parallel KEYS/VALUES arrays on bash 3.2 -- both of which reached values
# and keys through `eval`. Interpolating config-derived text into eval gave
# arbitrary code execution from a config file (see tests/unit/test_injection.bats).
#
# Nothing here evals. Values are written with `printf -v`, which never re-parses
# its argument. Keys are validated against [A-Za-z0-9._-] and then mangled to
# [A-Za-z0-9_], so a storage variable name can never contain `[`, `$`, a quote,
# or a backtick -- which also closes the `unset 'a[$(cmd)]'` arithmetic-subscript
# vector.
#
# Collapsing to one backend additionally fixes:
#   * bash 3.2 keeping removed providers after re-init (only the native branch
#     was ever cleared)
#   * bash 4.0/4.1 losing every provider, because a bare `declare -A` inside
#     init_config created function-locals that died on return
#   * zsh's has_provider_key matching keys as a glob rather than exactly
#   * key order differing between backends, which made output untestable

# The ten provider maps. Single source of truth: the reset path derives from
# this list, so it cannot drift from the writers the way the old code did.
LLM_PROVIDER_MAPS="PROVIDER_BASE_URLS PROVIDER_API_KEY_VARS PROVIDER_DEFAULT_MODELS PROVIDER_DESCRIPTIONS PROVIDER_ENABLED PROVIDER_PROTOCOLS PROVIDER_AUTH_TOKENS PROVIDER_SIGNUP_URLS PROVIDER_MAX_CONTEXT_TOKENS PROVIDER_GROUPS"

# Shell-specific indirection, resolved once at source time rather than per call.
# These are the only two shell branches in the whole store.
if [[ "${CURRENT_SHELL}" == "zsh" ]]; then
    # shellcheck disable=SC1087,SC2296  # zsh ${(P)} indirect expansion
    __llm_var_get()   { eval '__LLM_REPLY="${(P)1-}"'; }
    # shellcheck disable=SC2296
    __llm_var_isset() { eval '[[ -n "${(P)1+x}" ]]'; }
    # zsh does NOT word-split unquoted parameter expansions (no SH_WORD_SPLIT
    # by default), so `for x in $space_separated_list` iterates ONCE with the
    # whole string. ${=1} forces the split.
    #
    # IFS is set locally rather than inherited: a caller using the common
    # "bash strict mode" idiom `IFS=$'\n\t'` has no space in IFS, so splitting
    # would not happen at all and every caller of this helper would silently
    # operate on one giant pseudo-word.
    __llm_split()     { local IFS=' '; eval '__LLM_WORDS=(${=1})'; }
else
    __llm_var_get()   { __LLM_REPLY="${!1-}"; }
    __llm_var_isset() { [[ -n "${!1+x}" ]]; }
    # Inputs are our own fixed identifier lists, so there is nothing for
    # pathname expansion to act on here. IFS is local for the reason above.
    # shellcheck disable=SC2206
    __llm_split()     { local IFS=' '; __LLM_WORDS=($1); }
fi

# Canonical identifier predicate. Provider ids legitimately contain dots and
# hyphens -- quickstart schema v2 ships ids like kimi-k2.5 and glm-5.1 -- so the
# charset must allow them. Uses `case` globbing rather than [[ =~ ]] so
# BASH_REMATCH is never clobbered (load_config depends on it via get_match) and
# no locale-sensitive character class is involved.
_llm_id_is_safe() {
    case "$1" in
        "")                return 1 ;;
        *[!A-Za-z0-9._-]*) return 1 ;;
    esac
    return 0
}

# Build the storage variable name for (map, key) into __LLM_VN.
# Returns 1 for an invalid map or key. Deliberately uses a dedicated slot
# rather than __LLM_REPLY so a has_provider_key call cannot clobber a value
# fetch that is still in flight.
__llm_store_var() {
    local __m="$1" __k="$2" __x
    case "$__m" in
        ""|*[!A-Za-z0-9_]*) __LLM_VN=""; return 1 ;;
    esac
    if ! _llm_id_is_safe "$__k"; then
        __LLM_VN=""
        return 1
    fi
    # Injective mangling to a legal variable name. Order matters: underscore
    # first, so the escapes introduced below are not themselves re-escaped.
    # a-b and a_b must not collide.
    __x="${__k//_/_5f}"
    __x="${__x//./_2e}"
    __x="${__x//-/_2d}"
    __LLM_VN="__LLM_V_${__m}__${__x}"
}

# Set a value in a provider map. Returns 1 (without storing) for an invalid key.
set_provider_value() {
    local __map="$1" __key="$2" __value="$3" __vn __kn __n

    if ! __llm_store_var "$__map" "$__key"; then
        debug "rejected key '$__key' for map '$__map'"
        return 1
    fi
    __vn="$__LLM_VN"

    # First write for this key: append it to the ordered key registry.
    if ! __llm_var_isset "$__vn"; then
        __kn="__LLM_KN_${__map}"
        __llm_var_get "$__kn"
        __n="${__LLM_REPLY:-0}"
        printf -v "__LLM_K_${__map}__${__n}" '%s' "$__key"
        printf -v "$__kn" '%s' "$((__n + 1))"
    fi

    # printf -v assigns literally: the value is never parsed as code.
    printf -v "$__vn" '%s' "$__value"
}

# Get a value from a provider map.
# Sets __LLM_REPLY to the value, empty for a missing OR empty key. Existence is
# decided only by has_provider_key. No stdout, no subshell.
get_provider_value() {
    __LLM_REPLY=""
    __llm_store_var "$1" "$2" || return 1
    __llm_var_get "$__LLM_VN"
}

# Exact-match key existence. A key set to the empty string still exists.
has_provider_key() {
    __llm_store_var "$1" "$2" || return 1
    __llm_var_isset "$__LLM_VN"
}

# Populate __LLM_REPLY_KEYS with a map's keys in insertion order.
# Insertion order is now identical on every shell, so command output is stable
# and golden-output assertions are possible for the first time.
get_provider_keys() {
    local __map="$1" __n __i=0
    __LLM_REPLY_KEYS=()
    case "$__map" in
        ""|*[!A-Za-z0-9_]*) return 1 ;;
    esac
    __llm_var_get "__LLM_KN_${__map}"
    __n="${__LLM_REPLY:-0}"
    while [[ $__i -lt $__n ]]; do
        __llm_var_get "__LLM_K_${__map}__${__i}"
        # Append rather than assign by index: zsh arrays are 1-indexed, so
        # __LLM_REPLY_KEYS[0]= is an "invalid subscript" error there. `+=` is
        # correct in bash 3.1+ and zsh alike.
        __LLM_REPLY_KEYS+=("$__LLM_REPLY")
        __i=$((__i + 1))
    done
}

# Drop every key/value in a map and reset its registry.
clear_provider_map() {
    local __map="$1" __n __i=0 __key
    case "$__map" in
        ""|*[!A-Za-z0-9_]*) return 1 ;;
    esac
    __llm_var_get "__LLM_KN_${__map}"
    __n="${__LLM_REPLY:-0}"
    while [[ $__i -lt $__n ]]; do
        __llm_var_get "__LLM_K_${__map}__${__i}"
        __key="$__LLM_REPLY"
        if __llm_store_var "$__map" "$__key"; then
            unset "$__LLM_VN"
        fi
        unset "__LLM_K_${__map}__${__i}"
        __i=$((__i + 1))
    done
    unset "__LLM_KN_${__map}"
}

# ---------- Configuration Loading ----------

# Helper function to get user config path
get_user_config_path() {
    echo "${XDG_CONFIG_HOME:-${HOME}/.config}/llm-env/config.conf"
}

# Function to get configuration file locations (in order of precedence)
# Emit "tier<TAB>path" lines, highest precedence first.
#
# The system tier is now platform-derived rather than the single hardcoded
# /usr/local/etc: that path maps into C:\Program Files\Git on Git Bash and
# never exists, and it is the wrong prefix for Apple-Silicon Homebrew. Emitting
# the tier name alongside the path also removes the string comparison
# init_config used to decide CONFIG_SOURCE, which made "system" unreachable on
# any other layout.
get_config_locations() {
    local sysdirs d
    printf 'user\t%s\n' "$(get_user_config_path)"

    if [[ -n "${LLM_ENV_SYSTEM_CONFIG_DIRS:-}" ]]; then
        sysdirs="$LLM_ENV_SYSTEM_CONFIG_DIRS"
    else
        case "${__LLM_PLATFORM:-}" in
            macos)       sysdirs="/opt/homebrew/etc:/usr/local/etc" ;;
            linux|wsl)   sysdirs="/etc:/usr/local/etc" ;;
            msys|cygwin) sysdirs="${MINGW_PREFIX:+$MINGW_PREFIX/etc}" ;;
            *)           sysdirs="/usr/local/etc" ;;
        esac
    fi

    if [[ -n "$sysdirs" ]]; then
        # Split on ':' portably. `local IFS=':'; for d in $sysdirs` does NOT
        # work: zsh does not word-split unquoted expansions whatever IFS is,
        # so the whole "/opt/homebrew/etc:/usr/local/etc" string became one
        # entry and produced a single malformed path.
        __llm_split "${sysdirs//:/ }"
        for d in ${__LLM_WORDS[@]+"${__LLM_WORDS[@]}"}; do
            [[ -n "$d" ]] && printf 'system\t%s/llm-env/config.conf\n' "$d"
        done
    fi

    printf 'builtin\t%s/config/llm-env.conf\n' "$(__llm_normalize_path "$(get_script_dir)")"
}

declare -a AVAILABLE_PROVIDERS
declare -a AVAILABLE_GROUPS
# Output array for get_provider_keys (avoids a subshell per key enumeration)
# shellcheck disable=SC2034  # populated by get_provider_keys, consumed by callers
declare -a __LLM_REPLY_KEYS

# Load configuration from file
load_config() {
    local config_file="$1"
    debug "Attempting to load config from: $config_file"
    [[ ! -f "$config_file" ]] && { debug "Config file not found: $config_file"; return 1; }
    
    debug "Loading configuration from: $config_file"
    local current_provider=""
    local current_group=""
    local line_num=0
    
    # Read file content and process line by line to avoid subshell issues
    local file_content
    file_content="$(cat "$config_file")"

    # Classic-Mac line endings (lone CR, no LF anywhere) would otherwise arrive
    # as a single giant line. Convert those up front. CRLF is handled per-line
    # below instead, which keeps $line_num accurate for diagnostics.
    case "$file_content" in
        *$'\n'*) : ;;
        *$'\r'*) file_content="${file_content//$'\r'/$'\n'}" ;;
    esac

    # Regex patterns stored in variables for cross-shell compatibility
    local comment_pattern="^[[:space:]]*#"
    local empty_pattern="^[[:space:]]*$"
    local section_pattern="^\[([^]]+)\]$"
    local group_prefix_pattern="^group:"
    local keyval_pattern="^([^=]+)=(.*)$"

    # Declare loop variables outside the loop for zsh compatibility
    # In zsh, re-declaring local variables inside a loop prints previous values
    # ($line included -- it also used to leak into the caller's shell).
    local line key value normalized_protocol validated_protocol section_name max_ctx
    # Tracked so a file that parses to nothing can say so instead of silently
    # presenting an empty provider list as a successful load.
    local sections_found=0 meaningful_lines=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        line_num=$((line_num + 1))

        # Strip one trailing CR so CRLF files parse identically to LF ones.
        # Without this the section regex's `$` anchor never matches (the CR
        # sits between `]` and end-of-line) and every provider is dropped.
        line="${line%$'\r'}"

        # Skip comments and empty lines
        [[ "$line" =~ $comment_pattern ]] && continue
        [[ "$line" =~ $empty_pattern ]] && continue

        meaningful_lines=$((meaningful_lines + 1))

        # Section header
        if [[ "$line" =~ $section_pattern ]]; then
            sections_found=$((sections_found + 1))
            get_match 1; section_name="$__LLM_REPLY"
            # Validate before the name reaches any store call. The store
            # rejects unsafe keys on its own, but doing it here means the whole
            # section is skipped -- otherwise its key=value lines would silently
            # attach to whichever provider happened to be current -- and the
            # user gets one clear diagnostic instead of a stream of them.
            if [[ "$section_name" =~ $group_prefix_pattern ]]; then
                # Group section: [group:name]
                current_group="${section_name#group:}"
                current_provider=""
                if ! _llm_id_is_safe "$current_group"; then
                    echo "⚠️  Skipping group section '[$section_name]' (line $line_num): invalid name." >&2
                    echo "   Group names may contain letters, digits, dot, underscore and hyphen only." >&2
                    current_group=""
                    continue
                fi
                debug "Found group section: $current_group"
            else
                # Provider section: [name]
                current_provider="$section_name"
                current_group=""
                if ! _llm_id_is_safe "$current_provider"; then
                    echo "⚠️  Skipping provider section '[$section_name]' (line $line_num): invalid name." >&2
                    echo "   Provider names may contain letters, digits, dot, underscore and hyphen only." >&2
                    current_provider=""
                    continue
                fi
                debug "Found provider section: $current_provider"
            fi
            continue
        fi

        # Handle group key=value (only "providers" key supported)
        if [[ -n "$current_group" ]]; then
            if [[ "$line" =~ $keyval_pattern ]]; then
                get_match 1; key="$__LLM_REPLY"
                get_match 2; value="$__LLM_REPLY"
                trim "$key"; key="$__LLM_REPLY"
                trim "$value"; value="$__LLM_REPLY"
                if [[ "$key" == "providers" ]]; then
                    set_provider_value "PROVIDER_GROUPS" "$current_group" "$value"
                    debug "PROVIDER_GROUPS[$current_group] = $value"
                fi
            fi
            continue
        fi

        # Skip if no current provider
        [[ -z "$current_provider" ]] && continue

        # Parse key=value pairs
        if [[ "$line" =~ $keyval_pattern ]]; then
            get_match 1; key="$__LLM_REPLY"
            get_match 2; value="$__LLM_REPLY"

            # Trim whitespace (fork-free)
            trim "$key"; key="$__LLM_REPLY"
            trim "$value"; value="$__LLM_REPLY"

            debug "Setting $current_provider.$key = $value"

            case "$key" in
                base_url)
                    set_provider_value "PROVIDER_BASE_URLS" "$current_provider" "$value"
                    debug "PROVIDER_BASE_URLS[$current_provider] = $value"
                    ;;
                api_key_var)
                    set_provider_value "PROVIDER_API_KEY_VARS" "$current_provider" "$value"
                    ;;
                auth_token_var)
                    set_provider_value "PROVIDER_AUTH_TOKENS" "$current_provider" "$value"
                    ;;
                default_model)
                    set_provider_value "PROVIDER_DEFAULT_MODELS" "$current_provider" "$value"
                    ;;
                description)
                    set_provider_value "PROVIDER_DESCRIPTIONS" "$current_provider" "$value"
                    ;;
                enabled)
                    set_provider_value "PROVIDER_ENABLED" "$current_provider" "$value"
                    ;;
                signup_url)
                    set_provider_value "PROVIDER_SIGNUP_URLS" "$current_provider" "$value"
                    ;;
                protocol)
                    # Normalize protocol to lowercase and trim whitespace using helper function
                    normalized_protocol="$(normalize_protocol "$value")"
                    # Validate against whitelist and warn if invalid
                    validated_protocol="$(validate_protocol "$current_provider" "$normalized_protocol")"
                    set_provider_value "PROVIDER_PROTOCOLS" "$current_provider" "$validated_protocol"
                    debug "PROVIDER_PROTOCOLS[$current_provider] = $validated_protocol"
                    ;;
                max_context_tokens)
                    # No command substitution, unlike the protocol branch above:
                    # the value comes back in __LLM_REPLY, so a fifty-provider
                    # config costs no forks here instead of one per line.
                    #
                    # Copied out of __LLM_REPLY before set_provider_value runs.
                    # That function's key-registry path calls __llm_var_get,
                    # which overwrites __LLM_REPLY with the key count.
                    normalize_max_context_tokens "$current_provider" "$value"
                    max_ctx="$__LLM_REPLY"
                    # Only store a value that parsed. set_provider_value appends
                    # to the ordered key registry on first write regardless of
                    # value, so writing "" would register the provider for good
                    # and make get_provider_keys report a key nobody configured.
                    if [[ -n "$max_ctx" ]]; then
                        set_provider_value "PROVIDER_MAX_CONTEXT_TOKENS" "$current_provider" "$max_ctx"
                        debug "PROVIDER_MAX_CONTEXT_TOKENS[$current_provider] = $max_ctx"
                    fi
                    ;;
            esac
        fi
    done <<< "$file_content"

    # A file with real content that yielded no sections parsed to nothing. Say
    # so: silently reporting an empty provider list as a successful load is how
    # the CRLF defect stayed invisible. Comment-only and empty files are
    # legitimately section-free and must not warn.
    if [[ $sections_found -eq 0 && $meaningful_lines -gt 0 ]]; then
        echo "⚠️  Found no provider sections in $config_file (${meaningful_lines} non-comment lines)." >&2
        echo "   Check the file uses [section] headers and is not corrupted." >&2
    fi

    # Set default protocol for providers that don't have one explicitly set
    # Only applies to enabled providers
    apply_default_protocols

    return 0
}

# Initialize configuration
init_config() {
    debug "Initializing configuration"
    
    # Clear existing configuration.
    #
    # Derived from LLM_PROVIDER_MAPS so the reset can never drift from the set
    # of maps that writers actually use. The previous version reset only the
    # native associative arrays, leaving the bash-3.2 parallel arrays to
    # accumulate forever -- so on macOS's system bash, `config remove` followed
    # by `list` still showed the removed provider. It also re-declared the
    # arrays with a bare `declare -A` when `declare -g` was unavailable
    # (bash 4.0/4.1), which created function-locals that were destroyed on
    # return, emptying the whole provider set.
    local __m
    __llm_split "$LLM_PROVIDER_MAPS"
    for __m in ${__LLM_WORDS[@]+"${__LLM_WORDS[@]}"}; do
        clear_provider_map "$__m"
    done
    AVAILABLE_PROVIDERS=()
    AVAILABLE_GROUPS=()
    
    local config_loaded=false
    
    # Try to load configuration files in order of precedence
    # get_config_locations emits "tier<TAB>path". Taking the tier from the data
    # rather than string-comparing the path is what makes CONFIG_SOURCE=system
    # reachable on layouts other than /usr/local/etc. Tab is the separator so a
    # Windows-style path can never split a field.
    local config_tier
    while IFS=$'\t' read -r config_tier config_file; do
        [[ -n "$config_file" ]] || continue
        if load_config "$config_file"; then
            debug "Successfully loaded config from: $config_file (tier=$config_tier)"
            config_loaded=true
            CONFIG_SOURCE="$config_tier"
            break
        fi
    done < <(get_config_locations)
    
    if ! $config_loaded; then
        debug "No configuration file found, checking built-in fallback"
        # Check if built-in config file exists
        local builtin_config
        builtin_config="$(get_script_dir)/config/llm-env.conf"
        if [[ -f "$builtin_config" ]]; then
            echo "⚠️  No configuration file found. Using built-in defaults."
        echo "   Create $(get_user_config_path) for custom configuration."
        echo
            load_builtin_config
            CONFIG_SOURCE="builtin"
            config_loaded=true
        else
            CONFIG_SOURCE="none"
            config_loaded=false
        fi
    fi
    
    CONFIG_LOADED=$config_loaded
    
    # Build list of available providers
    debug "Building available providers list"
    AVAILABLE_PROVIDERS=()
    # Get all provider keys using wrapper function
    local -a provider_keys
    get_provider_keys "PROVIDER_BASE_URLS"
    provider_keys=(${__LLM_REPLY_KEYS[@]+"${__LLM_REPLY_KEYS[@]}"})
    debug "PROVIDER_BASE_URLS keys: ${provider_keys[*]-}"

    # Declare loop variables outside the loop for zsh compatibility
    local provider_enabled has_base_url has_api_key_var has_model has_protocol has_auth_token_var
    for provider in ${provider_keys[@]+"${provider_keys[@]}"}; do
        [[ -n "$provider" ]] || continue
        get_provider_value "PROVIDER_ENABLED" "$provider"; provider_enabled="$__LLM_REPLY"
        debug "Checking provider: $provider, enabled: ${provider_enabled:-true}"

        # Check if provider has all required fields
        get_provider_value "PROVIDER_BASE_URLS" "$provider"; has_base_url="$__LLM_REPLY"
        get_provider_value "PROVIDER_API_KEY_VARS" "$provider"; has_api_key_var="$__LLM_REPLY"
        get_provider_value "PROVIDER_DEFAULT_MODELS" "$provider"; has_model="$__LLM_REPLY"
        get_provider_value "PROVIDER_PROTOCOLS" "$provider"; has_protocol="$__LLM_REPLY"
        has_protocol="${has_protocol:-openai}"

        # base_url and model are always required
        if [[ -z "$has_base_url" || -z "$has_model" ]]; then
            debug "Skipping incomplete provider $provider: base_url='$has_base_url', model='$has_model'"
            continue
        fi

        # Credential validation: anthropic protocol accepts api_key_var or auth_token_var
        if [[ "$has_protocol" == "anthropic" ]]; then
            get_provider_value "PROVIDER_AUTH_TOKENS" "$provider"; has_auth_token_var="$__LLM_REPLY"
            if [[ -z "$has_api_key_var" && -z "$has_auth_token_var" ]]; then
                debug "Skipping incomplete anthropic provider $provider: no api_key_var or auth_token_var"
                continue
            fi
        elif [[ -z "$has_api_key_var" ]]; then
            debug "Skipping incomplete provider $provider: no api_key_var"
            continue
        fi

        # Only include enabled providers that have all required fields
        if [[ "${provider_enabled:-true}" == "true" ]]; then
            AVAILABLE_PROVIDERS+=("$provider")
            debug "Added $provider to AVAILABLE_PROVIDERS"
        fi
    done
    debug "Final AVAILABLE_PROVIDERS: ${AVAILABLE_PROVIDERS[*]-}"
    
    # Sort providers alphabetically (bash 3.2 compatible - no mapfile)
    local sorted_providers
    sorted_providers=$(printf '%s\n' ${AVAILABLE_PROVIDERS[@]+"${AVAILABLE_PROVIDERS[@]}"} | sort)
    AVAILABLE_PROVIDERS=()
    while IFS= read -r provider; do
        [[ -n "$provider" ]] && AVAILABLE_PROVIDERS+=("$provider")
    done <<< "$sorted_providers"

    # Build list of available groups
    AVAILABLE_GROUPS=()
    local -a group_keys
    get_provider_keys "PROVIDER_GROUPS"
    group_keys=(${__LLM_REPLY_KEYS[@]+"${__LLM_REPLY_KEYS[@]}"})
    local group_name
    for group_name in ${group_keys[@]+"${group_keys[@]}"}; do
        [[ -n "$group_name" ]] || continue
        AVAILABLE_GROUPS+=("$group_name")
        debug "Added group: $group_name"
    done
    debug "Final AVAILABLE_GROUPS: ${AVAILABLE_GROUPS[*]-}"

    return 0
}

