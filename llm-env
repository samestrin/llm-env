cmd_config_validate() {
    echo "🔍 Validating configuration..."

    local errors=0
    local warnings=0

    # Re-initialize to test configuration loading
    init_config

    # Declare loop variables outside loop for zsh compatibility
    local provider base_url api_key_var auth_token_var default_model enabled protocol cred_val
    local url_pattern="^https?://"

    # Check each provider
    get_provider_keys "PROVIDER_BASE_URLS"
    local -a validate_keys=(${__LLM_REPLY_KEYS[@]+"${__LLM_REPLY_KEYS[@]}"})
    for provider in ${validate_keys[@]+"${validate_keys[@]}"}; do
        [[ -z "$provider" ]] && continue
        get_provider_value "PROVIDER_BASE_URLS" "$provider"; base_url="$__LLM_REPLY"
        get_provider_value "PROVIDER_API_KEY_VARS" "$provider"; api_key_var="$__LLM_REPLY"
        get_provider_value "PROVIDER_AUTH_TOKENS" "$provider"; auth_token_var="$__LLM_REPLY"
        get_provider_value "PROVIDER_DEFAULT_MODELS" "$provider"; default_model="$__LLM_REPLY"
        get_provider_value "PROVIDER_ENABLED" "$provider"; enabled="${__LLM_REPLY:-true}"
        get_provider_value "PROVIDER_PROTOCOLS" "$provider"; protocol="${__LLM_REPLY:-openai}"

        echo "Checking provider: $provider"

        # Check required fields
        if [[ -z "$base_url" ]]; then
            echo "  ❌ Missing base_url"
            errors=$((errors + 1))
        elif [[ ! "$base_url" =~ $url_pattern ]]; then
            echo "  ⚠️  base_url should start with http:// or https://"
            warnings=$((warnings + 1))
        else
            echo "  ✅ base_url: $base_url"
        fi

        # Credential validation: anthropic protocol accepts api_key_var or auth_token_var
        if [[ "$protocol" == "anthropic" ]]; then
            if [[ -z "$api_key_var" && -z "$auth_token_var" ]]; then
                echo "  ❌ Missing api_key_var or auth_token_var"
                errors=$((errors + 1))
            else
                if [[ -n "$api_key_var" ]]; then
                    echo "  ✅ api_key_var: $api_key_var"
                    get_var_value "$api_key_var"; cred_val="$__LLM_REPLY"
                    if [[ -z "$cred_val" ]]; then
                        echo "  ⚠️  API key not set: $api_key_var"
                        warnings=$((warnings + 1))
                    else
                        echo "  ✅ API key is set"
                    fi
                fi
                if [[ -n "$auth_token_var" ]]; then
                    echo "  ✅ auth_token_var: $auth_token_var"
                    get_var_value "$auth_token_var"; cred_val="$__LLM_REPLY"
                    if [[ -z "$cred_val" ]]; then
                        echo "  ⚠️  Auth token not set: $auth_token_var"
                        warnings=$((warnings + 1))
                    else
                        echo "  ✅ Auth token is set"
                    fi
                fi
            fi
        elif [[ -z "$api_key_var" ]]; then
            echo "  ❌ Missing api_key_var"
            errors=$((errors + 1))
        else
            echo "  ✅ api_key_var: $api_key_var"

            # Check if API key is set
            get_var_value "$api_key_var"; cred_val="$__LLM_REPLY"
            if [[ -z "$cred_val" ]]; then
                echo "  ⚠️  API key not set: $api_key_var"
                warnings=$((warnings + 1))
            else
                echo "  ✅ API key is set"
            fi
        fi
        
        if [[ -z "$default_model" ]]; then
            echo "  ❌ Missing default_model"
            errors=$((errors + 1))
        else
            echo "  ✅ default_model: $default_model"
        fi
        
        if [[ "$enabled" != "true" && "$enabled" != "false" ]]; then
            echo "  ⚠️  enabled should be 'true' or 'false', got: $enabled"
            warnings=$((warnings + 1))
        fi
        
        echo
    done

    get_provider_keys "PROVIDER_BASE_URLS"
    echo "Validation complete:"
    echo "  Providers: ${#__LLM_REPLY_KEYS[@]}"
    echo "  Enabled: ${#AVAILABLE_PROVIDERS[@]}"
    echo "  Errors: $errors"
    echo "  Warnings: $warnings"
    
    if (( errors > 0 )); then
        echo "❌ Configuration has errors that need to be fixed"
    echo
        return 1
    elif (( warnings > 0 )); then
        echo "⚠️  Configuration has warnings but should work"
    echo
        return 0
    else
        echo "✅ Configuration is valid"
    echo
        return 0
    fi
}

cmd_config_backup() {
    local user_config
    user_config="$(get_user_config_path)"
    
    if [[ ! -f "$user_config" ]]; then
        echo "❌ Configuration file not found: ${user_config}"
        echo "💡 Run 'source llm-env config init' to create one"
        return 1
    fi
    
    # Create backup directory if it doesn't exist
    local backup_dir
    backup_dir="$(_config_backup_dir)"
    mkdir -p "$backup_dir"
    
    # Generate timestamp for backup filename
    local timestamp
    timestamp=$(date +%Y%m%d_%H%M%S)
    local backup_file="$backup_dir/config_${timestamp}.conf"
    
    # Create backup
    if cp "$user_config" "$backup_file"; then
        echo "✅ Configuration backed up to: $backup_file"
        echo
        echo "💡 To restore: source llm-env config restore $backup_file"
        
        # List recent backups
        echo ""
        echo "Recent backups:"
        find "$backup_dir" -name "*.conf" -type f -exec ls -lt {} + 2>/dev/null | head -5 | while read -r line; do
            echo "  $line"
        done
    else
        echo "❌ Failed to create backup"
        echo
        return 1
    fi
}

cmd_config_restore() {
    local backup_file="$1"
    local user_config
    user_config="$(get_user_config_path)"
    
    if [[ -z "$backup_file" ]]; then
        echo "Usage: source llm-env config restore <backup_file>"
        echo ""
        echo "Available backups:"
        local backup_dir
    backup_dir="$(_config_backup_dir)"
        if [[ -d "$backup_dir" ]]; then
            find "$backup_dir" -name "*.conf" -type f -exec ls -lt {} + 2>/dev/null | head -10 | while read -r line; do
                echo "  $line"
            done
        else
            echo "  No backups found"
        fi
        return 1
    fi
    
    if [[ ! -f "$backup_file" ]]; then
        echo "❌ Backup file not found: $backup_file"
        return 1
    fi
    
    # Confirm before restoring (skip in test environment)
    # Confirmation is skipped only on an explicit opt-in. This used to test
    # $BATS_TMPDIR, which bats exports to every child process -- so anyone
    # running under bats, including this project's own developers, silently
    # lost the prompt before their config was overwritten.
    if [[ "${LLM_ENV_ASSUME_YES:-}" != "1" ]]; then
        echo "⚠️  This will overwrite your current configuration:"
        echo "   Current: $user_config"
        echo "   Restore from: $backup_file"
        echo ""
        read -p "Continue? (y/N): " -n 1 -r
        echo
        local yes_pattern="^[Yy]$"
        # See cmd_config_init: $REPLY is `read`'s slot, not the accessors'.
        [[ ! $REPLY =~ $yes_pattern ]] && { echo "Restore cancelled"; return 1; }
    fi
    
    # Create backup of current config before restoring
    if [[ -f "$user_config" ]]; then
        local current_backup
        current_backup="${user_config}.pre-restore.$(date +%Y%m%d_%H%M%S)"
        cp "$user_config" "$current_backup"
        echo "💾 Current config backed up to: $current_backup"
    fi
    
    # Restore from backup
    if cp "$backup_file" "$user_config"; then
        echo "✅ Configuration restored from: $backup_file"
        echo
        echo "💡 Run 'source llm-env config validate' to verify"
    else
        echo "❌ Failed to restore configuration"
        echo
        return 1
    fi
}

cmd_config_bulk() {
    local action="$1"
    shift
    local providers=("$@")
    local user_config
    user_config="$(get_user_config_path)"
    
    if [[ -z "${action}" ]]; then
        echo "Usage: source llm-env config bulk <action> <provider1> [provider2] ..."
        echo ""
        echo "Actions:"
        echo "  enable    Enable specified providers"
        echo "  disable   Disable specified providers"
        echo ""
        echo "Examples:"
        echo "  source llm-env config bulk enable cerebras openai"
        echo "  source llm-env config bulk disable groq openrouter"
        return 1
    fi
    
    if [[ ${#providers[@]} -eq 0 ]]; then
        echo "❌ No providers specified"
        get_provider_keys "PROVIDER_BASE_URLS"
        echo "Available providers: ${__LLM_REPLY_KEYS[*]-}"
        return 1
    fi
    
    case "${action}" in
        enable|disable)
            ;;
        *)
            echo "❌ Invalid action: ${action}"
            echo "Valid actions: enable, disable"
            return 1
            ;;
    esac
    
    if [[ ! -f "$user_config" ]]; then
        echo "❌ Configuration file not found: $user_config"
        echo "💡 Run 'source llm-env config init' to create one"
        return 1
    fi
    
    # Create backup before making changes
    local backup_file
    backup_file="${user_config}.bulk-backup.$(date +%Y%m%d_%H%M%S)"
    cp "${user_config}" "${backup_file}"
    echo "💾 Configuration backed up to: ${backup_file}"
    
    echo "🔄 Performing bulk ${action} operation..."
    local success_count=0
    local failed_providers=()
    local enabled_value

    for provider in ${providers[@]+"${providers[@]}"}; do
        # Validate provider name format
        if ! validate_provider_name "${provider}"; then
            failed_providers+=("${provider} (invalid name)")
            continue
        fi

        # Check if provider exists in config
        if ! has_provider_key "PROVIDER_BASE_URLS" "$provider"; then
            failed_providers+=("${provider} (not found)")
            continue
        fi

        # Set enabled value based on action
        case "${action}" in
            enable) enabled_value="true" ;;
            disable) enabled_value="false" ;;
        esac
        
        # Update configuration file
        # Check against the FILE being edited, not the in-memory config: the
        # loaded config may have come from a different precedence tier, in
        # which case awk found nothing and this still reported success.
        if ! grep -qFx "[${provider}]" "${user_config}"; then
            failed_providers+=("${provider} (not found in ${user_config})")
            continue
        fi

        # Rewrite atomically. Previously awk's exit status was never checked
        # before an unconditional mv, so a failed or missing awk replaced the
        # config with an empty file and still printed a success line; and mv
        # from a fresh temp dropped the original's mode (600 -> 644).
        #
        # The section/enabled matching tolerates leading whitespace and a
        # trailing CR: /^enabled=/ missed "  enabled=true" and appended a
        # duplicate key instead of updating the existing one.
        # $0 is awk's field variable; values are passed via -v.
        # shellcheck disable=SC2016
        if _config_atomic_write "${user_config}" \
            awk -v section="[${provider}]" -v enabled="${enabled_value}" '
            BEGIN { in_section = 0; found = 0; found_enabled = 0 }
            {
                line = $0
                sub(/\r$/, "", line)
                stripped = line
                sub(/^[ \t]+/, "", stripped)
            }
            stripped ~ /^\[/ {
                if (stripped == section) {
                    in_section = 1
                    found = 1
                } else {
                    if (in_section && !found_enabled) {
                        print "enabled=" enabled
                        found_enabled = 1
                    }
                    in_section = 0
                }
                print
                next
            }
            in_section && stripped ~ /^enabled=/ {
                print "enabled=" enabled
                found_enabled = 1
                next
            }
            { print }
            END {
                if (found && !found_enabled) {
                    print "enabled=" enabled
                }
            }
        '; then
            echo "  ✅ ${provider}: ${action}"
            success_count=$((success_count + 1))
        else
            failed_providers+=("${provider} (update failed; config unchanged)")
        fi
    done
    
    echo ""
    echo "📊 Bulk operation results:"
    echo "  Successful: ${success_count}/${#providers[@]}"
    
    if [[ ${#failed_providers[@]} -gt 0 ]]; then
        echo "  Failed:"
        for failure in ${failed_providers[@]+"${failed_providers[@]}"}; do
            echo "    ❌ ${failure}"
        done
    fi
    
    # Reload configuration to reflect changes
    init_config
    
    echo ""
    echo "💡 Run 'source llm-env config validate' to verify changes"
    echo "💡 Run 'source llm-env list' to see updated provider list"

    # Report failure to the caller. It always returned 0, so a scripted bulk
    # operation could not tell that nothing had been changed.
    [[ ${#failed_providers[@]} -eq 0 ]]
}

# ---------- Entry Point ----------

# Run init + command dispatch inside a function so the caller's nounset
# setting can be restored on every exit path (see set +u near the top).
__llm_env_run() {
# Initialize configuration on script load
init_config

# Handle commands when called with arguments (works both when sourced and executed directly)
# Skip command processing if the argument looks like a BATS test name
if [[ $# -gt 0 ]] && [[ "$1" != test_* ]]; then
case "$1" in
    --version)
        echo "llm-env - LLM Environment Manager v${LLM_ENV_VERSION}"
        ;;
    --help|help)
        cmd_help
        ;;
    set)
        shift
        cmd_set "$1"
        ;;
    unset)
        cmd_unset
        ;;
    list)
        # shift first: without it cmd_list's $1 was the literal string "list",
        # so `[[ "$1" == "--all" ]]` never matched and disabled providers were
        # unreachable from the CLI.
        shift
        cmd_list "$@"
        ;;
    show)
        cmd_show
        ;;
    test)
        shift
        cmd_test "$1"
        ;;
    config)
        shift
        cmd_config "$@"
        ;;
    quickstart)
        shift
        cmd_quickstart "$@"
        ;;
    *)
        echo "Unknown command: $1" >&2
        echo "Use 'source llm-env --help' for usage information." >&2
        return 1
        ;;
esac
fi
}
__llm_env_run "$@"
__LLM_ENV_RC=$?
[[ "${__LLM_ENV_RESTORE_NOUNSET:-0}" == "1" ]] && set -u
unset __LLM_ENV_RESTORE_NOUNSET
# When sourced, `return` exits here; when executed directly it fails and the
# `exit` runs instead. shellcheck cannot see the executed path.
# shellcheck disable=SC2317
return "$__LLM_ENV_RC" 2>/dev/null || exit "$__LLM_ENV_RC"
